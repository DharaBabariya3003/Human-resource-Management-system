<!DOCTYPE html>
<html lang="en">
<head>
	<!-- Import Head -->
	<%- include('layout/head') -%>
</head>
<body>
	<div class="app app-login p-0">
		<div class="row g-0 app-auth-wrapper">
			<div class="col-12 col-md-7 col-lg-6 auth-main-col text-center p-5">
				<div class="d-flex flex-column align-content-end">
					<div class="app-auth-body mx-auto">
						<div class="app-auth-branding mb-4"><a class="app-logo" href="#">
							<img class="mr-2 logoFormat" src="/assets/images/background/bigscal-logo.png" alt="logo"></a></div>
						<h2 class="auth-heading text-center mb-5 demo loginFont">Log in to Portal</h2>
						<div class="auth-form-container text-left">
							<form class="auth-form login-form" method="POST" action="/auth/login">
								<div class="email mb-3">
									<label class="sr-only" for="signin-email">Email</label>
									<input name="email" type="email" class="form-control signin-email" placeholder="Email address"
										value=<%if(oldValues) {%> <%= oldValues.old.email %><%}%>>
								</div>
								<!--//form-group-->
								<div class="password mb-3">
									<label class="sr-only" for="signin-password">Password</label>
									<input name="password" type="password" class="form-control signin-password" placeholder="Password"
										value=<%if(oldValues) {%> <%= oldValues.old.password %> <%}%> >
											<div class="extra mt-3 row justify-content-between">
												<div class="col-6">
													
												</div>
												<!--//col-6-->
												<div class="col-6">
													<div class="forgot-password text-right">
														<a href="/auth/forgot-password">Forgot password?</a>
													</div>
												</div>
												<!--//col-6-->
											</div>
											<!--//extra-->
								</div>
								<!--//form-group-->
								<div class="text-center">
									<button type="submit" class="btn app-btn-primary btn-block theme-btn mx-auto" id="loginbtn">Log
										In</button>
								</div>
       </form>
      </div>
      <!--//auth-form-container-->
     </div>
     <!--//auth-body-->
     <%- include('layout/footer') -%>
    </div>
				<!--//flex-column-->
			</div>
			<!--//auth-main-col-->
			<div class="col-12 col-md-5 col-lg-6 h-100 auth-background-col">
				<div class="auth-background-holder">
				</div>
				<div class="auth-background-mask"></div>
				<div class="auth-background-overlay p-3 p-lg-5">
					<div class="d-flex flex-column align-content-end h-100">
						<div class="h-100"></div>
						<div class="overlay-content p-3 p-lg-4 rounded">
							<h5 class="mb-3 overlay-title">Bigscal Technologies Pvt Ltd.</h5>
							<div>
								We are a leading custom software development company providing world-magnificence software program development offerings primarily based totally on years of experience, a group of certified professionals, key enterprise insights, and dedicated workflows.
							</div>
						</div>
					</div>
				</div>
				<!--//auth-background-overlay-->
			</div>
   <!--//auth-background-col-->
  </div>
		<!--//row-->
	</div>
	<%- include('./layout/externalScript') -%>
</body>
</html>