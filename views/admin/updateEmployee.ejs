<script>
		
	$(document).ready(function() {

var data = {}; 
$("#encodings option").each(function(i,el) {  
	data[$(el).data("value")] = $(el).val();
});
 $('#bankName').change(function(){
	var value = $('#bankName').val();
	var userId = $('#encodings [value="' + value + '"]').data('value');
	if(!userId){
		$('#bankId').val("");
		return false;
	}else{
		$('#bankId').val(userId);
	}
});
$('#bankName').keydown(function(){
	$('#bankId').val("");
});

});

</script>
