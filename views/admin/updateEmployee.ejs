<!DOCTYPE html>
<html lang="en">
<head>
	<!-- Import Head -->
	<%- include('../layout/head') -%>
<script src="/assets/jQuery/timepickerjs.min.js"></script>
<script src="/assets/jQuery/timepicker.min.js"></script>

</head>
<body>
	<%- include('../layout/header') -%>	
		<div class="app">
			<div class="app-wrapper">			
				<div class="app-content pt-3 p-md-3 p-lg-4">
					<div class="container-xl">
						<h1 class="app-page-title">Edit Employee Details</h1>
						
						
							<form method="POST" action="/admin/<%if(oldValues.old){%>
								<%= oldValues.old._id %>
							<%}else{
								if(oldValues){%>
									<%= oldValues._id %>
								<%}
							}%>/employee" enctype="multipart/form-data">
								<div class="app-card app-card-accordion shadow-sm mb-4 card-neumorphic">
									<div class="app-card-header p-3 bg-success cardHeader">
										<h4 class="app-card-title"><strong>Basic Details :</strong></h4>
									</div>																		
									<!--//app-card-header-->
									<div class="app-card-body p-2 pt-0">
										<div id="faq2-accordion" class="faq2-accordion faq-accordion accordion">
											<div class="item border-bottom py-3">
												<div class="row justify-content-between align-items-center row-6">
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>First Name:<span class="requiredField">*</span></strong>
																</div>
																<div class="item-data">
																	<input name="firstName" class="form-control"
																		placeholder="First Name" type="text" 
																		value=<%if(oldValues.old){%>
																			<%- JSON.stringify(oldValues.old.firstName)%>
																		<%}else{
																			if(oldValues){%>
																				<%- JSON.stringify(oldValues.firstName)%>
																			<%}
																		}%>>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Middle Name:</strong></div>
																<div class="item-data">
																	<input name="middleName" class="form-control"
																		placeholder="Middle Name"  type="text"
																		value=<%if(oldValues.old){%>
																			<%- JSON.stringify(oldValues.old.middleName)%>
																		<%}else{
																			if(oldValues){%>
																				<%- JSON.stringify(oldValues.middleName)%>
																			<%}
																		}%>>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Last Name:<span class="requiredField">*</span></strong>
																</div>
																<div class="item-data">
																	<input name="lastName" class="form-control"
																		placeholder="Last Name" type="text"
																		value=<%if(oldValues.old){%>
																			<%- JSON.stringify(oldValues.old.lastName)%>
																		<%}else{
																			if(oldValues){%>
																				<%- JSON.stringify(oldValues.lastName)%>
																			<%}
																		}%>>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
												</div>
												<!--//row-->
											</div>
											<!--//item-->
											<div class="item border-bottom py-3">
												<div class="row justify-content-between align-items-center row-6">
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Email Address:<span class="requiredField">*</span></strong>
																</div>
																<div class="item-data">
																	<input name="email" class="form-control restrictSpace"
																		placeholder="Email Address"
																		type="email" value=<%if(oldValues.old){%>
																			<%- JSON.stringify(oldValues.old.email)%>
																		<%}else{
																			if(oldValues){%>
																				<%- JSON.stringify(oldValues.email)%>
																			<%}
																		}%>>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Birth Date:<span class="requiredField">*</span></strong>
																</div>
																<div class="item-data">
																	<input name="birthDate" class="form-control"
																		placeholder="Birth" type="date" min="1900-01-01"
																		max="9999-12-31" style="margin-right: 10px;"
																		value=<%if(oldValues.old){%>
																			<%= oldValues.old.moment(oldValues.old.birthDate).format("YYYY-MM-DD") %>
																		<%}else{
																			if(oldValues){%>
																				<%= oldValues.moment(oldValues.birthDate).format("YYYY-MM-DD") %>
																			<%}
																		}%>>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Gender:</strong></div>
																<div class="item-data">
																	<select name="gender" class="form-control form-select">
																		<option value="Male" <%if(oldValues.old){
																			if(oldValues.old.gender=='Male' ) {%>
																				<%= 'selected' %>
																			<%} 
																		}else{
																			if(oldValues){
																				if(oldValues.gender=='Male' ) {%>
																					<%= 'selected' %>
																				<%} 
																			}
																		}%>>Male</option>
																		<option value="Female" <%if(oldValues.old){
																			if(oldValues.old.gender=='Female' ) {%>
																				<%= 'selected' %>
																			<%} 
																		}else{
																			if(oldValues){
																				if(oldValues.gender=='Female' ) {%>
																					<%= 'selected' %>
																				<%} 
																			}
																		}%>>Female
																		</option>
																		<option value="Others" <%if(oldValues.old){
																			if(oldValues.old.gender=='Others' ) {%>
																				<%= 'selected' %>
																			<%} 
																		}else{
																			if(oldValues){
																				if(oldValues.gender=='Others' ) {%>
																					<%= 'selected' %>
																				<%} 
																			}
																		}%>>Others
																		</option>
																	</select>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
												</div>
											</div>
											<!--//item-->
											<div class="item border-bottom py-3">
												<div class="row justify-content-between align-items-center row-6">
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Your Contact
																		Info:<span class="requiredField">*</span></strong></div>
																<div class="item-data">
																	<input name="contactNumber" class="form-control"
																		placeholder="Contact Info."
																		type="number"
																		onKeyPress="if(this.value.length==10) return false;"
																		value=<%if(oldValues.old){%>
																			<%=oldValues.old.contactNumber %>
																		<%}else{
																			if(oldValues){%>
																				<%=oldValues.contactNumber %>
																			<%}
																		}%>>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Emergency Contact
																		Info:</strong></div>
																<div class="item-data">
																	<input name="emergencyContactNumber"
																		class="form-control"
																		placeholder="Emrgency Contact Info."
																		type="number"
																		onKeyPress="if(this.value.length==10) return false;"
																		value=<%if(oldValues.old){%>
																			<%=oldValues.old.emergencyContactNumber %>
																		<%}else{
																			if(oldValues){%>
																				<%=oldValues.emergencyContactNumber %>
																			<%}
																		}%>>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Position:</strong></div>
																<div class="item-data">
																	<select name="position" class="form-control form-select">
																		<option value="Trainee" <%if(oldValues.old){
																			if(oldValues.old.position=='Trainee') {%>
																				<%= 'selected' %>
																			<%} 
																		}else{
																			if(oldValues){
																				if(oldValues.position=='Trainee') {%>
																					<%= 'selected' %>
																				<%} 
																			}
																		}%>>Trainee
																		</option>
																		<option value="Employee" <%if(oldValues.old){
																			if(oldValues.old.position=='Employee') {%>
																				<%= 'selected' %>
																			<%} 
																		}else{
																			if(oldValues){
																				if(oldValues.position=='Employee') {%>
																					<%= 'selected' %>
																				<%} 
																			}
																		}%>>Employee
																		</option>
																	</select>
																</div> <!-- form-group end.// -->
															</div>
														</div>
													</div>
												</div>
											</div>
											<!--//item-->
											<div class="item border-bottom py-3">
												<div class="row justify-content-between align-items-center row-6">
													<div class="col-sm-6">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Correspondence
																		Address:<span class="requiredField">*</span></strong></div>
																<div class="item-data">
																	<textarea name="correspondenceAddress"
																		 placeholder="Correspondence Address" style="height: 87px !important;"
																		class="form-control"><%if(oldValues.old){%>
																			<%=oldValues.old.correspondenceAddress %>
																		<%}else{
																			if(oldValues){%>
																				<%= oldValues.correspondenceAddress %>
																			<%}
																		}%></textarea>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
													<div class="col-sm-6">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Permanent
																		Address:</strong></div>
																<div class="item-data">
																	<textarea name="permanentAddress"
																		 placeholder="Permanent Address" style="height: 87px !important;"
																		class="form-control"><%if(oldValues.old){%>
																			<%=oldValues.old.permanentAddress %>
																		<%}else{
																			if(oldValues){%>
																				<%= oldValues.permanentAddress %>
																			<%}
																		}%></textarea>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
												</div>
											</div>
											<!--//item-->
											<div class="item border-bottom py-3">
												<div class="row justify-content-between align-items-center row-6">
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Department:</strong>
																</div>
																<div class="item-data">
																<select id="combo"  onchange="getDepartment();"  name="department" class="form-control form-select">
																	<%if(oldValues.old){
																		if(oldValues.old.allDept){
																			if(oldValues.old.allDept.length>0){
																				oldValues.old.allDept.forEach(element=>{%>
																					<option value=<%= element._id %> <%if(''+oldValues.old.department==''+element._id){%>
																						selected
																						<%}%>> <%= element.departmentName %></option>
																				<%})
																			}
																		}
																	}else{
																	 if(oldValues) {
																		if(oldValues.allDept){
																			if(oldValues.allDept.length>0){
																				oldValues.allDept.forEach(element=>{%>
																					<option value=<%= element._id %> <%if(''+oldValues.department==''+element._id){%>
																						selected
																						<%}%>> <%= element.departmentName %></option>
																						<%})
																					}
																			}
																	 }
																	}%>
																</select>
																<div class="item-data refreshFormat">
																	<i class="fas fa-redo-alt" onclick="getDepartmentRefresh()" style="cursor: pointer;"></i>
																</div>
																	</div> <!-- form-group end.// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Designation:</strong>
																</div>
																<div class="item-data">																
																	<select id="selectDeg" name="designation" class="form-control form-select">
																		<%if(oldValues.old){
																			if(oldValues.old.allDesg){
																				if(oldValues.old.allDesg.length>0){
																					oldValues.old.allDesg.forEach(element=>{%>
																				<option value=<%= element._id %> <%if(''+oldValues.old.designation==''+element._id){%>
																					selected
																				<%}%>> <%= element.designationName %></option>
																				<%})
																				}
																			}
																		}else{
																		 if(oldValues) {
																			if(oldValues.allDesg){
																				if(oldValues.allDesg.length>0){
																					oldValues.allDesg.forEach(element=>{%>
																				<option value=<%= element._id %> <%if(''+oldValues.designation==''+element._id){%>
																					selected
																				<%}%>> <%= element.designationName %></option>
																				<%})
																				}
																			}
																		 }
																		}%>
																	</select>
																	<div class="item-data refreshFormat">
																		<i class="fas fa-redo-alt" onclick="getDepartment()" style="cursor: pointer;"></i>
																	</div>
																</div> <!-- form-group end.// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Vehicle Number:</strong>
																</div>
																<div class="item-data">
																	<input name="vehicalNumber" class="form-control"
																		placeholder="Vehicle Number" type="text"
																		value=<%if(oldValues.old){%>
																			<%- JSON.stringify( oldValues.old.vehicalNumber) %>
																		<%}else{
																			if(oldValues){%>
																				<%- JSON.stringify( oldValues.vehicalNumber) %>
																			<%}
																		}%>>
																</div>
															</div>
														</div>
													</div>												
												</div>
											</div>
											<!--//item-->
										
											<div class="item border-bottom py-3" style="border-bottom: none !important;">
												<div class="row justify-content-between align-items-center row-6">
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Status:</strong></div>
																<div class="item-data">
																	<select id="statusSelector" name="status"
																		class="form-control form-select">
																		<option value="Single" <%if(oldValues.old){
																			if(oldValues.old.status=='Single') {%>
																				<%= 'selected' %>
																			<%} 
																		}else{
																			if(oldValues){
																				if(oldValues.status=='Single') {%>
																					<%= 'selected' %>
																				<%} 
																			}
																		}%>>Single
																		</option>
																		<option value="Married" <%if(oldValues.old){
																			if(oldValues.old.status=='Married') {%>
																				<%= 'selected' %>
																			<%} 
																		}else{
																			if(oldValues){
																				if(oldValues.status=='Married') {%>
																					<%= 'selected' %>
																				<%} 
																			}
																		}%>>Married
																		</option>
																	</select>
																</div> <!-- form-group end.// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
														<div class="mb-3">
																<div class="item-label"><strong>System Role:</strong></div>
																<div class="item-data">
																	<select name="role" class="form-control form-select">
																		<option value="User" <%if(oldValues.old){
																			if(oldValues.old.role.name=='user') {%>
																				<%= 'selected' %>
																			<%} 
																		}else{
																			if(oldValues){
																				if(oldValues.role.name=='user') {%>
																					<%= 'selected' %>
																				<%} 
																			}
																		}%>>User
																		</option>
																		<option value="HR Recruiter" <%if(oldValues.old){
																			if(oldValues.old.role.name=='HR Recruiter') {%>
																				<%= 'selected' %>
																			<%} 
																		}else{
																			if(oldValues){
																				if(oldValues.role.name=='HR Recruiter') {%>
																					<%= 'selected' %>
																				<%} 
																			}
																		}%>>HR Recruiter</option>
																		<option value="HR" <%if(oldValues.old){
																			if(oldValues.old.role.name=='HR') {%>
																				<%= 'selected' %>
																			<%} 
																		}else{
																			if(oldValues){
																				if(oldValues.role.name=='HR') {%>
																					<%= 'selected' %>
																				<%} 
																			}
																		}%>>HR
																		</option>
																	</select>
																</div> <!-- form-group end.// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3" id="MarriageDateSelection">
																<div class="item-label"><strong>Marriage Date:</strong></div>
																<div class="item-data">
																	<input name="marriageDate" class="form-control"
																		type="date" style="margin-right: 10px;"
																		min="1900-01-01" max="9999-12-31"
																		value=<%if(oldValues.old){%>
																			<%= oldValues.old.moment(oldValues.old.marriageDate).format("YYYY-MM-DD"); %>
																		<%}else{
																			if(oldValues){%>
																				<%= oldValues.moment(oldValues.marriageDate).format("YYYY-MM-DD"); %>
																			<%}else{%>
																				<%= oldValues.moment(new Date()).format("YYYY-MM-DD"); %>
																			<%}
																		}%>>
																	</div> <!-- form-group// -->
																</div>
														</div>
													</div>
												</div>
											</div>
											<!--//item-->
										</div>
										<!--//faq2-accordion-->
									</div>
									<!--//app-card-body-->
								</div>
								<!--//app-card-->
								<div class="app-card app-card-accordion shadow-sm mb-4 card-neumorphic">
									<div class="app-card-header p-3 bg-success cardHeader">
										<h4 class="app-card-title"><strong>Education Details :</strong></h4>
									</div>
									<!--//app-card-header-->
									<div class="app-card-body p-2 pt-0">
										<div id="faq2-accordion" class="faq2-accordion faq-accordion accordion">
											<div class="item border-bottom py-3" style="border-bottom: none !important;">
												<div class="row justify-content-between align-items-center row-6">
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Degree:</strong></div>
																<div class="item-data">
																	<input name="degree"  class="form-control"
																		placeholder="Degree" type="text" value=<%if(oldValues.old){%>
																			<%- JSON.stringify( oldValues.old.degree) %>
																		<%}else{
																			if(oldValues){%>
																				<%- JSON.stringify( oldValues.degree) %>
																			<%}
																		}%>>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>College Name:</strong>
																</div>
																<div class="item-data">
																	<input name="collegeName" class="form-control"
																		placeholder="College Name"  type="text"
																		value=<%if(oldValues.old){%>
																			<%- JSON.stringify( oldValues.old.collegeName) %>
																		<%}else{
																			if(oldValues){%>
																				<%- JSON.stringify( oldValues.collegeName) %>
																			<%}
																		}%>>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">																
																<div class="item-label"><strong>Year Of Passing:</strong></div>
																<div class="item-data">
																	<input name="YearOfPassing" 
																		class="form-control" id="incrementDatePicker"
																		placeholder="Year Of Passing" type="number"
																		onKeyPress="if(this.value.length==4) return false;"
																		value=<%if(oldValues.old){%>
																			<%- JSON.stringify( oldValues.old.YearOfPassing) %>
																		<%}else{
																			if(oldValues){%>
																				<%= oldValues.YearOfPassing %>
																			<%}
																		}%>>
																	</div> <!-- form-group// -->
															</div>
														</div>
													</div>
												</div>
												<!--//row-->
											</div>
											<!--//item-->											
										</div>
										<!--//faq2-accordion-->
