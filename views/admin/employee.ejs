<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Import Head -->
  <%- include('../layout/head') -%>
  <style>    
		.hideTd{
			display: none;
		}
  </style>
</head>
<body>
  
  <%- include('../layout/header') -%>
  <div class="app">
    
    <div class="app-wrapper">
      <div class="app-content pt-3 p-md-3 p-lg-4">
        <div class="container-xl">
          <div class="row g-3 mb-4 align-items-center justify-content-between">
            <div class="col-auto">
              <input type="hidden" id="userFullName" value="<%= oldValues.userName %>">
              <input type="hidden" id="userDesignationName" value="<%= oldValues.userDesignation %>">
              <input type="hidden" id="userEmail" value="<%= oldValues.email %>">

              <h1 class="app-page-title mb-0">Employees<span class="totalEmployees">Total:&nbsp;<span id="totalEmployees"></span></span></h1>
            </div>
            <div class="col-auto">
              <div class="page-utilities">
                <div class="row g-2 justify-content-start justify-content-md-end align-items-center">
                  <div class="col-auto">
                    <select class="form-select form-select-sm w-auto form-control empAttendanceType" id="tdsUsers">
                      <option value="All" disabled selected hidden>---Users---</option>
                      <option value="All">All Users</option>
                      <option value="tds">TDS Users</option>
                    </select>
                  </div>
                  <div class="col-auto">
                    <select class="form-select form-select-sm w-auto form-control empAttendanceType" id="selectedGender" >
                      <option value="All" disabled selected hidden>---Select Gender---</option>
                      <option value="All">All</option>
                      <option value="Male">Male</option>
                      <option value="Female">Female</option>
                      <option value="Others">Others</option>
                    </select>
                  </div>
                  <div class="col-auto" style="margin-top: -13px !important;">
                    <a href="#" id="downloadEmpXlsSheet">
                        Download xls-sheet
                    </a>
                    <select class="form-select form-select-sm w-auto form-control empAttendanceType" id="selectedOrganizationType" >
                      <option value="All" disabled selected hidden>---Organization Type---</option>
                      <option value="All">All</option>
                      <option value="Bigscal">Bigscal</option>
                      <option value="Healthray">Healthray</option>
                    </select>
                  </div>
                  <div class="col-auto">
                    <select class="form-select form-select-sm w-auto form-control empAttendanceType" id="selectedAttendanceType" >
                      <option value="All" disabled selected hidden>---Attendance Type---</option>
                      <option value="All">All Type</option>
                      <option value="Card">Card Type</option>
                      <option value="Tracker">Tracker Type</option>
                      <option value="Client Tracker">Client Tracker Type</option>
                    </select>
                  </div>
                  <div class="col-auto">
                    <a class="btn btn-success btn-green-neumorpic" href="/admin/create/employee" style="border-radius: 0;">
                      Add New Employee
                    </a>                    
                  </div>
                </div><!--//row-->
              </div><!--//table-utilities-->
            </div><!--//col-auto-->
          </div><!--//row-->
          <div class="tab-content" id="orders-table-tab-content">
            <div class="tab-pane fade show active" id="orders-all" role="tabpanel" aria-labelledby="orders-all-tab">
              <div class="app-card app-card-orders-table shadow-sm mb-5 card-neumorphic">
                <div class="app-card-body">
                  <table class="table app-table-hover mb-0 text-left" id="serverEmployeeTable">
                    <thead>
                      <tr>
                        <th class="cell" style="display: none;">Sr.No</th>
                        <th class="cell">Employee Code</th>
                        <th class="cell">First Name</th>
                        <th class="cell">Middle Name</th>
                        <th class="cell">Last Name</th>
                        <th class="cell">Email-ID</th>
                        <th class="cell">Contact Number</th>
                        <th class="cell">Vehicle Number</th>
                        <th class="cell text-center" colspan="4">Action</th>                        
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                  </table>
                </div><!--//app-card-body-->
              </div><!--//app-card-->
            </div>            
          </div><!--//tab-content-->
        </div><!--//container-fluid-->
      </div><!--//app-content-->
      <%- include('../layout/footer') -%>
    </div><!--//app-wrapper-->
  </div>
  <%- include('../layout/script') -%>
  <script src="/js/leftModalDialogEmployee.js"></script>
  <script>
    var userFullName = document.getElementById('userFullName').value;
    var userDesignationName = document.getElementById('userDesignationName').value;
    var userEmail = document.getElementById('userEmail').value;

    var headerInformation = {
      userFullName: userFullName,
      userDesignationName: userDesignationName,
      userEmail: userEmail
    }
    window.localStorage.setItem('headerInformation',JSON.stringify(headerInformation));
  </script>
  <script>
    $(document).ready(function() {
      $('#selfRadioBtn').click(function(e){
        $('#resignationInformationDiv').show();
      });
      $('#companyRadioBtn').click(function(e){
        $('#resignationInformationDiv').show();
      });
      $('#abscondingRadioBtn').click(function(e){
        $('#resignationInformationDiv').hide();
      });
  });
  </script>
  <script>
    $(function () {
    var table;
    $("#selectedAttendanceType").change(function(){	
      table.ajax.reload(null, false);
    });
    $("#selectedOrganizationType").change(function(){	
      table.ajax.reload(null, false);
    });
    $("#selectedGender").change(function(){	
      table.ajax.reload(null, false);
    });
    $("#tdsUsers").change(function(){	
      table.ajax.reload(null, false);
    });
    
    table = $("#serverEmployeeTable").DataTable({
        "autoWidth": false,
        "scrollX": true,
        "order": [[ 0, 'desc' ]],
        "serverSide": true,
        "ordering": false,
        "serverMethod": 'get',
        'ajax': {
          'url': '/admin/api/employeeTable',
          'data': function (data) {					
            data.selectedAttendanceType = $('#selectedAttendanceType').val();
            data.selectedOrganizationType = $('#selectedOrganizationType').val();
            data.selectedGender = $('#selectedGender').val();
            data.tdsUsers = $('#tdsUsers').val();
          }
        },  
        "columns": [{
          data: "",
          className: 'hideTd',
          "defaultContent": "-"
        },{
          data: "attendanceCode",
          "defaultContent": "-"
        }, {
          data: "firstName",
          "defaultContent": "-"
        }, {
          data: "middleName",
          "defaultContent": "-"
        },{
          data: "lastName",
          "defaultContent": "-"
        },{
          data: "email",
          "defaultContent": "-"
        },{
          data: "contactNumber",
          "defaultContent": "-"
        },{
          data: "vehicalNumber",  
          "defaultContent": "-"
        },
        {
            data: "_id",
            "className": "d-flex",
            "render": function (data, type, row) {
                  return `	<a href="/admin/view/<%= 'profile' %>/${row._id}" class="btn btn-outline-primary btn-round-purple-neumorpic" data-toggle="tooltip" title="View Employee Details"                                   
                                    style="border-radius: 0%;">
                                    <i class="fas fa-eye"></i>
                            </a>
                            <a href="/admin/${row._id}/employee" class="btn btn-outline-success btn-round-green-neumorpic" data-toggle="tooltip" title="Edit Profile" 
                                    style="border-radius: 0%;">
                                    <i class="fas fa-edit"></i>
                                  </a>
                            <a data-toggle="modal" data-id="${row._id},${row.resignationDate}"
                                title="Left Employee" class="open-LeftModalDialog btn btn-outline-danger btn-round-red-neumorpic"
                                href="#leftModalDialog" style="border-radius: 0%;">
                                <strong>Left</strong></a>	
                            <a href="/admin/attendance/${row._id}/show" class="btn btn-outline-info btn-round-cyan-neumorpic" data-toggle="tooltip" title="Attendance Details" 
                                style="border-radius: 0%;">
                                <i class="fas fa-pen-alt"></i>
                              </a>
                          <a href="/admin/attendance/${row._id}/salary" class="btn btn-outline-warning btn-round-mustered-neumorpic" data-toggle="tooltip" title="Salary Details" 
                                style="border-radius: 0%;">
                                <i class="fas fa-file"></i>
                              </a>`;
            }
        }
        
        

        ],
        "fnRowCallback": function(nRow, aData, iDisplayIndex) {
          var oSettings = table.settings()[0];
          $("td:first", nRow).html(oSettings._iDisplayStart + iDisplayIndex + 1);
          return nRow;
        },
        "fnDrawCallback": function () {				
          let rowCount = $("#serverEmployeeTable tr").length;					
          rowCount = this.api().page.info().recordsTotal;				
          document.getElementById("totalEmployees").textContent = rowCount;
			}
      });
    });
    $("#downloadEmpXlsSheet").click(function() {
      let organizationType = $('#selectedOrganizationType').val();
      if(!organizationType){
        organizationType = 'All';
      }
      $.ajax({    
        url : `/admin/api/employee-xlsSheet?organizationType=${organizationType}`,
        type: 'GET',
        success: function (data, textStatus, xhr) {
          if(data.status){
            toastr.success("Xls sheet downloaded successfully !!!");
            window.location.href = `/public/downloadExcel/${data.xlsFileNameEmployee}.xlsx`;
          }else{
            toastr.error("Xls sheet is not available !!!");
          }
        },
      });
    });
  </script>
</body>
</html>

<!-- -------------------------------------------------------------------------------------------- -->

<div class="modal" tabindex="-1" role="dialog" id="leftModalDialog" >
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Write reason of left here.</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <form method="POST" action="/admin/left" id="Q_A">
          <input type="hidden" name="leftUserId" id="leftId" />
          <div class="item border-bottom py-3">
            <div class="row justify-content-between align-items-center row-6">
              <div class="col-sm-12">
                <div class="col-auto">
                  <div class="mb-3">
                    <div class="item-data">
                      <input class="form-control" type="text" name="leftReason" required placeholder="write reason of left here">
                    </div> <!-- form-group end.// -->
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--//item-->
          <div class="item border-bottom py-3">
            <div class="row justify-content-between align-items-center row-6">
              <div class="col-sm-12">
                <div class="col-auto">
                  <div class="mb-3">
                    <div class="item-data">
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="leftLetter" value="self" id="selfRadioBtn" checked>
                        <label class="form-check-label" for="inlineRadio1">Self</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="leftLetter" value="company" id="companyRadioBtn">
                        <label class="form-check-label" for="inlineRadio2">Company</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="leftLetter" value="absconding" id="abscondingRadioBtn">
                        <label class="form-check-label" for="inlineRadio3">Absconding</label>
                      </div>
                    </div> <!-- form-group end.// -->
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--//item-->
          <div class="item border-bottom py-3" style="border-bottom: 0;">
            <div class="row justify-content-between align-items-center row-6">
              <div class="col-sm-6" id="resignationInformationDiv">
                <div class="col-auto">
                  <div class="mb-3">
                    <div class="item-label"><strong>Resign Date:</strong></div>
                    <div class="item-data">
                      <input name="resignDate" id="resignId" class="form-control col-10" type="date" min="1900-01-01"
                        max="9999-12-31" style="margin-right: 10px;">
                    </div> <!-- form-group end.// -->
                  </div>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="col-auto">
                  <div class="mb-3">
                    <div class="item-label"><strong>Left Date:</strong></div>
                    <div class="item-data">
                      <input name="leftDate" class="form-control col-10" type="date" min="1900-01-01" max="9999-12-31"
                        style="margin-right: 10px;">
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--//item-->
          <div class="modal-footer">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>


<!-- -------------------------------------------------------------------------------------------- -->