<!DOCTYPE html>
<html lang="en">
<head>
<!-- Import Head -->
<%- include('../layout/head') -%>   
<script src="/assets/jQuery/timepickerjs.min.js"></script>
<script src="/assets/jQuery/timepicker.min.js"></script>
</head>	
<body>	
	
<%- include('../layout/header') -%>   
<div class="app">
  <div class="app-wrapper">
		<div class="app-content pt-3 p-md-3 p-lg-4">
		  <div class="container-xl">
				<h1 class="app-page-title">Employee Registration</h1>			
					<form method="POST" action="/admin/store/employee" enctype="multipart/form-data">
						<div class="app-card app-card-accordion shadow-sm mb-4 card-neumorphic">
							<div class="app-card-header p-3 bg-success cardHeader">
								<h4 class="app-card-title"><strong> Basic Details :</strong></h4>
							</div><!--//app-card-header-->						
							<div class="app-card-body p-2 pt-0">
								<div id="faq2-accordion" class="faq2-accordion faq-accordion accordion">
									<div class="item border-bottom py-3">
										<div class="row justify-content-between align-items-center row-6">
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>First Name<span class="requiredField">*</span></strong></div>
														<div class="item-data">
															<input name="firstName" id="firstName" class="form-control" placeholder="First Name" onkeypress="return blockSpecialChar(event)" type="text" value=<%if(oldValues.old)
															{%>
																<%- JSON.stringify(oldValues.old.firstName) %>
															<%}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Middle Name</strong></div>
														<div class="item-data">
															<input name="middleName" id="middleName" class="form-control" placeholder="Middle Name" onkeypress="return blockSpecialChar(event)"  type="text" value=<%if(oldValues.old)
															{%>
																	<%- JSON.stringify(oldValues.old.middleName) %>
															<%}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>
											<div class="col-sm-4">
												<div class="col-auto">
												<div class="mb-3">
													<div class="item-label"><strong>Last Name<span class="requiredField">*</span></strong></div>
														<div class="item-data">
														<input name="lastName" id="lastName" class="form-control" placeholder="Last Name" onkeypress="return blockSpecialChar(event)" type="text"  value=<%if(oldValues.old)
														{%>
															<%- JSON.stringify(oldValues.old.lastName) %>
														<%}%>>
														</div> <!-- form-group// -->
												</div>
												</div>
											</div>		
										</div><!--//row-->
									</div><!--//item-->
									<div class="item border-bottom py-3">
										<div class="row justify-content-between align-items-center row-6">
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Email Address<span class="requiredField">*</span></strong></div>
														<div class="item-data">
														<input name="email" class="form-control restrictSpace" placeholder="Email Address"  type="email"  value=<%if(oldValues.old)
															{%>
																<%= oldValues.old.email %>
															<%}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>																					
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Birth Date<span class="requiredField">*</span></strong></div>
														<div class="item-data">
															<input name="birthDate" class="form-control"  placeholder="Birth" type="date" min="1900-01-01" max="9999-12-31" style="margin-right: 10px;" value=<%if(oldValues.old)
															{%>
																<%= oldValues.old.birthDate %>
															<%}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>		
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Gender</strong></div>
															<div class="item-data">
																<select name="gender" class="form-control form-select">
																<option value="Male" 
																<%if(oldValues.old)
																{%>
																	<%if(oldValues.old.gender=='Male')
																	{%>
																		<%= 'selected'%>
																	<%}%>
																<%}%>>Male</option>
																<option value="Female" 
																<%if(oldValues.old)
																{%>
																	<%if(oldValues.old.gender=='Female')
																	{%>
																		<%= 'selected'%>
																	<%}%>
																<%}%>>Female</option>
																<option value="Others" 
																<%if(oldValues.old)
																{%>
																	<%if(oldValues.old.gender=='Others')
																	{%>
																		<%= 'selected'%>
																	<%}%>
																<%}%>>Others</option>
																</select>
															</div> <!-- form-group// -->
													</div>
												</div>
											</div>
										</div>
									</div><!--//item-->	
									<div class="item border-bottom py-3">
										<div class="row justify-content-between align-items-center row-6">
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Your Contact Info<span class="requiredField">*</span></strong></div>
														<div class="item-data">
															<input name="contactNumber" class="form-control restrictSpace" placeholder="Contact Info." type="number" onKeyPress="if(this.value.length==10) return false;" value=<%if(oldValues.old)
															{%>
																<%= oldValues.old.contactNumber %>
															<%}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Emergency Contact Info</strong></div>
														<div class="item-data">
															<input name="emergencyContactNumber" class="form-control restrictSpace" placeholder="Emrgency Contact Info."  type="number" onKeyPress="if(this.value.length==10) return false;" value=<%if(oldValues.old)
															{
															if(oldValues.old.emergencyContactNumber==='0000000000')
															{%>
															<%}
															else
															{%>
																<%= oldValues.old.emergencyContactNumber %>
															<%}
														}%>>
													</div> <!-- form-group// -->
													</div>
												</div>
											</div>
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Position</strong></div>
														<div class="item-data">
															<select name="position" class="form-control form-select">
																	<option value="Trainee" <%if(oldValues.old)
																{%>
																	<%if(oldValues.old.position=='Trainee')
																	{%>
																		<%= 'selected'%>
																	<%}%>
																<%}%>>Trainee</option>
																<option value="Employee" 
																<%if(oldValues.old)
																{%>
																	<%if(oldValues.old.position=='Employee')
																	{%>
																		<%= 'selected'%>
																	<%}%>
																<%}%>>Employee</option>
															</select>
														</div> <!-- form-group end.// -->
													</div>
												</div>
											</div>
										</div>		
									</div><!--//item-->	
									<div class="item border-bottom py-3">
										<div class="row justify-content-between align-items-center row-6">
											<div class="col-sm-6">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Correspondence Address<span class="requiredField">*</span></strong></div>
														<div class="item-data">														
															<textarea name="correspondenceAddress" 
															placeholder="Correspondence Address" style="height: 87px !important;"
														 class="form-control"><%if(oldValues.old){
															if(oldValues.old.correspondenceAddress!='-'){%>
																<%= oldValues.old.correspondenceAddress %>
															<%}
														}%></textarea>													
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>	
											<div class="col-sm-6">
												<div class="col-auto">
												<div class="mb-3">
													<div class="item-label"><strong>Permanent Address</strong></div>
													<div class="item-data">													
														<textarea name="permanentAddress" 
														placeholder="Permanent Address" style="height: 87px !important;"
													 class="form-control"><%if(oldValues.old){
														if(oldValues.old.permanentAddress!='-'){%>
															<%= oldValues.old.permanentAddress %>
														<%}
													}%></textarea>
													</div> <!-- form-group// -->
												</div>
												</div>
											</div>	
										</div>
									</div><!--//item-->	
									<%if(oldValues.old){
										if(oldValues.old.designation){%>
										  <script>
												window.onload = function() {
													getDesignation(`<%= oldValues.old.designation %>`);
												};
											</script>
										<%}
									}else{%>
										<script>
											window.onload = function() {
												getDepartment();
											};
										</script>
									<%}%>
									<div class="item border-bottom py-3">
										<div class="row justify-content-between align-items-center row-6">
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Department<span class="requiredField">*</span></strong></div>													
														<div class="item-data">
														<select id="combo"  onchange="getDepartment();" name="department" class="form-control form-select">															
															<%if(oldValues.old){
																if(oldValues.old.allDept) {
																		if(oldValues.old.allDept.length>0){
																			oldValues.old.allDept.forEach(element=>{%>
																			
																				<option value=<%= element._id %> <%if(''+oldValues.old.department==''+element._id){%>
																					selected
																				<%}%>> <%= element.departmentName %></option>
																			<%})
																		}
																	}
															}else{
																if(oldValues.allDept){
																	if(oldValues.allDept.length>0){
																		oldValues.allDept.forEach(element=>{%>
																			
																	<option  value=<%= element._id %>> <%= element.departmentName %></option>
																	<%})
																}
															}
															}%>														
														</select>
														<div class="item-data refreshFormat">
															<i class="fas fa-redo-alt" onclick="getDepartmentRefresh()" style="cursor: pointer;"></i>
														</div>
														</div> <!-- form-group end.// -->
													</div>
												</div>
											</div>											
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Designation<span class="requiredField">*</span></strong></div>
														<div class="item-data">
																<select id="selectDeg" name="designation" class="form-control form-select">
																</select>
																<div class="item-data refreshFormat">
																	<i class="fas fa-redo-alt" onclick="getDepartment()" style="cursor: pointer;"></i>
																</div>
														</div> <!-- form-group end.// -->
													</div>
												</div>
											</div>											
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Vehicle Number</strong></div>
														<div class="item-data">
															<input name="vehicalNumber" class="form-control" placeholder="Vehicle Number" type="text" value=<%if(oldValues.old){
																if(oldValues.old.vehicalNumber!='-'){%>
																	<%- JSON.stringify(oldValues.old.vehicalNumber) %>
																<%}
															}%>>
														</div>
													</div>
												</div>
											</div>												
										</div>		
									</div><!--//item-->										
									<div class="item border-bottom py-3" style="border-bottom: none !important;">
										<div class="row justify-content-between align-items-center row-6">
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Marital Status</strong></div>
														<div class="item-data">
															<select id="statusSelector" name="status" class="form-control form-select">
																<option selected value="Single" <%if(oldValues.old)
																{%>
																	<%if(oldValues.old.status=='Single')
																	{%>
																		<%= 'selected'%>
																	<%}%>
																<%}%>>Single</option>
																<option value="Married" <%if(oldValues.old)
																{%>
																	<%if(oldValues.old.status=='Married')
																	{%>
																		<%= 'selected'%>
																	<%}%>
																<%}%>>Married</option>	
															</select>
														</div> <!-- form-group end.// -->
													</div>
												</div>
											</div>	
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>System Role</strong></div>
														<div class="item-data">
															<select name="role" class="form-control form-select">
																<option value="User" <%if(oldValues.old)
																{%>
																	<%if(oldValues.old.role=='user')
																	{%>
																		<%= 'selected'%>
																	<%}%>
																<%}%>>User</option>
																<option value="HR Recruiter" <%if(oldValues.old)
																{%>
																	<%if(oldValues.old.role=='HR Recruiter')
																	{%>
																		<%= 'selected'%>
																	<%}%>
																<%}%>>HR Recruiter</option>
																<option value="HR" 
																<%if(oldValues.old)
																{%>
																	<%if(oldValues.old.role=='HR')
																	{%>
																		<%= 'selected'%>
																	<%}%>
																<%}%>>HR</option>
															</select>
														</div> <!-- form-group end.// -->
													</div>
												</div>
											</div>
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3" id="MarriageDateSelection">
														<div class="item-label"><strong>Marriage Date</strong></div>
														<div class="item-data" >
															<input  name="marriageDate" class="form-control"  placeholder="Birth" type="date"  min="1900-01-01" max="9999-12-31" style="margin-right: 10px;" value=<%if(oldValues.old)
															{
																	if(oldValues.old.marriageDate)
																	{%>
																			<%= oldValues.old.marriageDate %>
																	<%}																	
															}else{%>
																<%= oldValues.moment(new Date()).format("YYYY-MM-DD"); %>
															<%}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>
										</div>		
									</div><!--//item-->	
								</div><!--//faq2-accordion-->
							</div><!--//app-card-body-->
						</div><!--//app-card-->
						<div class="app-card app-card-accordion shadow-sm mb-4 card-neumorphic">
							<div class="app-card-header p-3 bg-success cardHeader">
								<h4 class="app-card-title"><strong>Education Details :</strong></h4>
							</div><!--//app-card-header-->
							<div class="app-card-body p-2 pt-0">
								<div id="faq2-accordion" class="faq2-accordion faq-accordion accordion">
									<div class="item border-bottom py-3" style="border-bottom: none !important;">
										<div class="row justify-content-between align-items-center row-6" >
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Degree</strong></div>
														<div class="item-data">
															<input name="degree" class="form-control" placeholder="Degree" type="text" value=<%if(oldValues.old){
																if(oldValues.old.degree!='-'){%>
																	<%- JSON.stringify(oldValues.old.degree) %>
																<%}
															}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>	
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>College Name</strong></div>
														<div class="item-data">
															<input name="collegeName" class="form-control" placeholder="College Name" type="text" value=<%if(oldValues.old){
																if(oldValues.old.collegeName!='-'){%>
																	<%- JSON.stringify(oldValues.old.collegeName) %>
																<%}
															}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>	
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Year Of Passing</strong></div>
														<div class="item-data">
															
															<input name="YearOfPassing" class="form-control restrictSpace" id="incrementDatePicker" placeholder="Year Of Passing" type="number" onKeyPress="if(this.value.length==4) return false;" value=<%if(oldValues.old){
																if(oldValues.old.YearOfPassing!='0000'){%>
																	<%= oldValues.old.YearOfPassing %>
																<%}
															}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>
										</div><!--//row-->
									</div><!--//item-->									
								</div><!--//faq2-accordion-->
							</div><!--//app-card-body-->
						</div><!--//app-card-->
						<div class="app-card app-card-accordion shadow-sm mb-4 card-neumorphic">
							<div class="app-card-header p-3 bg-success cardHeader">
								<h4 class="app-card-title"><strong>Bank Details :</strong></h4>
							</div><!--//app-card-header-->
							<div class="app-card-body p-2 pt-0">
								<div id="faq2-accordion" class="faq2-accordion faq-accordion accordion">
									<div class="item border-bottom py-3">
										<div class="row justify-content-between align-items-center row-6">
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>IFSC Code</strong></div>
														<div class="item-data">
															<input name="ifscCode" class="form-control restrictSpace" placeholder="IFSC Code"  type="text" value=<%if(oldValues.old){
																if(oldValues.old.ifscCode!='-'){%>
																	<%- JSON.stringify(oldValues.old.ifscCode) %>
																<%}
															}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Account Holder Name</strong></div>
														<div class="item-data">
														<input name="accountHolderName" class="form-control" placeholder="Account Holder Name"  type="text" value=<%if(oldValues.old){
															if(oldValues.old.accountHolderName!='-'){%>
																<%- JSON.stringify(oldValues.old.accountHolderName) %>
															<%}
														}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>
											
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Bank Name</strong></div>
														<div class="item-data">
															<input type="hidden" name="bankId" id="bankId" value=<%if(oldValues.old){
																if(oldValues.old.bankId){%>
																	<%- JSON.stringify(oldValues.old.bankId) %>
																<%}
															}%>>
															<input list="encodings" name="bankName" type="text" id="bankName" placeholder="Select bank name" class="form-control form-select" value=<%if(oldValues.old){
																if(oldValues.old.bankName){%>
																	<%- JSON.stringify(oldValues.old.bankName) %>
																<%}
															}%>>
															<datalist id="encodings" class="selectBankName">
																<%if(oldValues.old){
																	if(oldValues.old.allBanks) {
																			if(oldValues.old.allBanks.length>0){
																				oldValues.old.allBanks.forEach(element=>{%>
																					<option data-value='<%= element._id %>' value=<%- JSON.stringify(element.bankName) %>></option>
																				<%})
																			}
																		}
																}else{
																	if(oldValues.allBanks){
																		if(oldValues.allBanks.length>0){
																			oldValues.allBanks.forEach(element=>{%>
																				<option data-value='<%= element._id %>' value=<%- JSON.stringify(element.bankName) %>></option>
																		<%})
																	}
																}
																}%>
															</datalist>
														</div> <!-- form-group// -->
														<div class="item-data refreshFormatBank">
															<i class="fas fa-redo-alt" onclick="refreshBankName()" style="cursor: pointer;"></i>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div><!--//item-->	
									<div class="item border-bottom py-3" style="border-bottom: none !important;">
										<div class="row justify-content-between align-items-center row-6">												
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>Account Number</strong></div>
														<div class="item-data">
															<input name="accountNumber" class="form-control" onkeypress="return event.charCode >= 48" min="0" placeholder="Account Number" type="number" value=<%if(oldValues.old)
															{
																if(oldValues.old.accountNumber!='0')
																{%>
																	<%- JSON.stringify(oldValues.old.accountNumber) %>
																<%}
															}%>>
														</div> <!-- form-group// -->
													</div>
												</div>
											</div>	
										</div><!--//row-->
									</div><!--//item-->
								</div><!--//faq2-accordion-->
							</div><!--//app-card-body-->
