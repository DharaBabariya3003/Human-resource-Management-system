<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Import Head -->
    <%- include('../layout/head') -%>
</head>
<body <%if(oldValues.availableMsgM=='Yes') {%> onload="dateAlreadyInserted()" <%}%>>
  <%- include('../layout/header') -%>
  <div class="app">		
    <div class="app-wrapper">
      <div class="app-content pt-3 p-md-3 p-lg-4">
        <div class="container-xl">			    
					<h1 class="app-page-title">Add Holidays</h1>					
          <hr class="mb-4">
          <div class="row g-4 settings-section">
          	<div class="col-12 col-md-12">
              <div class="app-card app-card-settings shadow-sm p-4 card-neumorphic">
            		<div class="app-card-body">
                  <div class="item border-bottom py-3" style="border: none !important;">
										<div class="row justify-content-between align-items-center row-6">
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<%if(oldValues.holidayDateValue) { var res=oldValues.holidayDateValue.split("/"); }%>
														<div class="item-label">
															<strong>Select Date:</strong>
														</div>
														<div class="item-data">
															<input type="date" required id="holidayDate"  min=<%=new Date().getFullYear()+"-01-01" %> max="9999-12-31" class="form-control"
																value=<%if(oldValues.holidayDateValue) {%>
																	<%= res[2]+"-"+res[1]+"-"+res[0] %>
																		<%}else{%>
																			<%= oldValues.moment(new Date()).format("YYYY-MM-DD"); %>
																		<%}%>>
														</div><!-- form-group// -->	
														<div class="item-label" id="selectDateMsg">
														</div>
													</div>
												</div>
											</div>
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label">
															<strong>Holiday Reason:</strong>
														</div>
														<div class="item-data">
															<input type="text" required id="holidayReason" placeholder="Reason"
																class="form-control" value=<% if(oldValues.holidayReasonValue) {%>
																<%= oldValues.holidayReasonValue%>
																<%}%>>
														</div>
													</div>
												</div>
											</div>
											<div class="col-sm-4">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-label"><strong>&nbsp;</strong>
														</div>
														<div class="item-data">
															<button class="btn btn-sucess btn-block btn-green-neumorpic" style="border-radius: 0;"
																onclick="storeHoliday(event)">Add to holidays list</button>
														</div>
													</div>
												</div>
											</div>
										</div><!--//row-->
									</div>
									<div class="item border-bottom py-3" style="border: none !important;">
										<div class="row justify-content-between align-items-center row-6">
											<div class="col-sm-12">
												<div class="col-auto">
													<div class="mb-3">													
													</div>
												</div>
											</div>
										</div><!--//row-->
									</div>
									<% let count=0; %>
									<div class="app-card app-card-orders-table mb-5 card-neumorphic">
										<div class="app-card-body px-4 w-100">
											<table class="table app-table-hover mb-0 text-left asc-data-table">
												<thead>
													<tr>
														<th class="cell"> Sr.No </th>
														<th class="cell"> Holiday Date </th>
														<th class="cell"> Holiday Reason </th>
														<th class="cell"> Action </th>
													</tr>
												</thead>
												<tbody>
													<%if(oldValues.holidayData.length>0){
														oldValues.holidayData.forEach(element=>{%>
																<tr>
																	<td> <%= ++count; %> </td>
																	<td>
																		<%
																		let revStr=element.holidayDate;
																		revStr=revStr.split("/");
																		revStr=revStr[2]+"-"+revStr[1]+"-"+revStr[0];
																		element.holidayDate=oldValues.moment(revStr).format("DD MMM YYYY");%>
																		<%= element.holidayDate %>
																	</td>
																	<td> <%= element.holidayReason%> </td>
																	<td>
																		<button type="button"
																			onclick="deleteHoliday('<%= element._id %>')"
																			class="btn btn-outline-danger btn-round-red-neumorpic" style="border-radius: 0%;" data-toggle="tooltip" title="Delete">
																			<i class="fas fa-trash"></i>
																		</button>
																	</td>
																</tr>
														<%})
													}%>
												</tbody>
											</table>
										</div>
									</div>
									<div class="item border-bottom py-3" style="border: none !important;">
										<div class="row justify-content-between align-items-center row-6">
											<div class="col-sm-9">
												<div class="col-auto">
													<div class="mb-3">
														<div class="item-data">
														</div> <!-- form-group end.// -->
													</div>
												</div>
											</div>
											<div class="col-sm-3">
												<div class="col-auto">
													<div class="mb-3">
														<%if(oldValues.holidayData.length>0){%>
															<div class="item-data">
																	<form method="POST" action="/admin/holidays/create">
																		<button class="btn btn-sucess btn-block btn-green-neumorpic"
																			style="border-radius: 0;">Save</button>
																	</form>
															</div><!-- form-group// -->
														<%}%>
													</div>
												</div>
											</div>	
										</div>		
									</div><!--//item-->	
								</div>
							</div>
            </div>
        	</div>
      	</div>
      </div><!--//container-fluid-->
    </div><!--//app-content-->
    <%- include('../layout/footer') -%>
	</div><!--//app-wrapper-->
	<%- include('../layout/script') -%>
	<script src="/js/deleteEmployee.js"></script>
	<script src="/js/holidayHandler.js"></script>
	
</body>
</html>