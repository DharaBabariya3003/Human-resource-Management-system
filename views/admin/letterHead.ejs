              </div><!--//col-->
            </div><!--//row-->
          </div><!--//item-->

          <div class="item border-bottom py-3">
            <div class="row justify-content-between align-items-center row-6">
              <div class="col-sm-4">
                <div class="item-label"><strong>Issue Date</strong></div>
                <div class="item-data">
                  <span id="show_issueDate"></span>
                </div>
              </div><!--//col-->
              <div class=" col-sm-4">
                <div class="item-label"><strong>Letterhead Type</strong></div>
                <div class="item-data">
                  <span id="show_letterheadType"></span>
                </div>
              </div><!--//col-->
