            <div class="col-sm-4">
              <div class="col-auto">
              <div class="mb-3">
                <div class="item-label"><strong></strong></div>
              </div>
              </div>
            </div>		
          </div><!--//row-->
        </div><!--//item-->
        <div class="modal-footer">
          <button type="submit" onclick="$.fn.updateLetterHeadFuc()" class="btn btn-primary">Update</button>
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>