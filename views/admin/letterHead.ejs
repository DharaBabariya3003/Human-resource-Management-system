          <div class="item border-bottom py-3" style="border-bottom: none !important;">
            <div class="row justify-content-between align-items-center row-6">
              <div class="col-sm-4">
                <div class="item-label"><strong>Document</strong></div>
                <div class="item-data">
                  <span id="show_letterHeadDocument"></span>
                </div>
              </div><!--//col-->
              <div class=" col-sm-4">
                <div class="item-label"><strong>Note</strong></div>
                <div class="item-data">
                  <span id="show_note"></span>
                </div>
              </div><!--//col-->
              <div class=" col-sm-4">
                <div class="item-label"><strong>Created By</strong></div>
                <div class="item-data">
                  <span id="show_createdBy"></span>
                </div>
              </div><!--//col-->
            </div><!--//row-->
          </div><!--//item-->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- -------------------------------------------------------------------------------------------- -->

