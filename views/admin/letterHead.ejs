          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="item border-bottom py-3">
          <form enctype="multipart/form-data">
          <div class="row justify-content-between align-items-center row-6">
            <input type="hidden" id="edit_letterHeadID">
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Letterhead Number<span class="requiredField">*</span></strong></div>
                  <div class="item-data">
                    <input id="edit_letterHeadNumber" class="form-control" placeholder="Letterhead Number" required type="text">
                  </div> <!-- form-group// -->
                </div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Issuer Name<span class="requiredField">*</span></strong></div>
                  <div class="item-data">
                    <input id="edit_issuerName" class="form-control" placeholder="Issuer Name" required type="text">
                  </div> <!-- form-group// -->
                </div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="col-auto">
              <div class="mb-3">
                <div class="item-label"><strong>Issue To<span class="requiredField">*</span></strong></div>
                  <div class="item-data">
                    <input id="edit_issueTo" class="form-control" placeholder="Issue To" required type="text">
                  </div> <!-- form-group// -->
              </div>
              </div>
            </div>
          </div><!--//row-->
        </form>
        </div><!--//item-->
        <div class="item border-bottom py-3">
          <div class="row justify-content-between align-items-center row-6">
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Issue Date<span class="requiredField">*</span></strong></div>
                  <div class="item-data">
                    <input id="edit_issueDate" class="form-control" required type="date">
                  </div> <!-- form-group// -->
                </div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Letterhead Type<span class="requiredField">*</span></strong></div>
                  <div class="item-data">
                    <select id="edit_letterheadType" required class="form-control form-select"></select>
                  </div> <!-- form-group// -->
                </div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="col-auto">
              <div class="mb-3">
                <div class="item-label"><strong>Reason</strong></div>
                  <div class="item-data">
                    <textarea id="edit_reason" placeholder="Reason" style="height: 87px !important;" class="form-control"></textarea>
                  </div> <!-- form-group// -->
              </div>
              </div>
            </div>		
          </div><!--//row-->
        </div><!--//item-->
        <div class="item border-bottom py-3">
          <div class="row justify-content-between align-items-center row-6">
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Upload Document<span class="requiredField">*</span></strong></div>
                  <div class="item-data wrapper">
                    <input type="file" accept="image/*, .doc, .pdf" id="edit_letterHeadDocument" class="form-control">
                    <span id="showEditLetterHeadImg"></span>
                  </div> <!-- form-group// -->
                </div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Note</strong></div>
                  <div class="item-data">
                    <textarea id="edit_note" placeholder="Note" style="height: 87px !important;" class="form-control"></textarea>
