<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Import Head -->
  <%- include('../layout/head') -%>
  <style>    
		.hideTd{
			display: none;
		}
    .wrapper {
    display: flex;
    }
  </style>
</head>
<body>
  <%- include('../layout/header') -%>
  <div class="app">
    <div class="app-wrapper">
      <div class="app-content pt-3 p-md-3 p-lg-4">
        <div class="container-xl">
          <div class="row g-3 mb-4 align-items-center justify-content-between">
            <div class="col-auto">
              <h1 class="app-page-title mb-0">Letterhead</h1>
            </div>
            <div class="col-auto">
              <div class="page-utilities">
                <div class="row g-2 justify-content-start justify-content-md-end align-items-center">
                  <div class="col-auto">
                    <a onclick="getAllLetterHeadTypesAdd()" data-toggle="modal" class="open-LetterModalDialog btn btn-success btn-green-neumorpic"
                      href="#letterModalDialog" style="border-radius: 0%;"><strong>Add New Letterhead</strong></a>
                  </div>
                </div><!--//row-->
              </div><!--//table-utilities-->
            </div><!--//col-auto-->
          </div><!--//row-->
          <div class="tab-content" id="orders-table-tab-content">
            <div class="tab-pane fade show active" id="orders-all" role="tabpanel" aria-labelledby="orders-all-tab">
              <div class="app-card app-card-orders-table shadow-sm mb-5 card-neumorphic">
                <div class="app-card-body">
                  <table class="table app-table-hover mb-0 text-left" id="letterHeadTable">
                    <thead>
                      <tr>
                        <th class="cell" >Sr.No</th>
                        <th class="cell">Letterhead Number</th>
                        <th class="cell">Issuer Name</th>
                        <th class="cell">Issue To</th>
                        <th class="cell">Issue Date</th>
                        <th class="cell">Letterhead Type</th>
                        <th class="cell text-center" colspan="4"></th>                        
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                  </table>
                </div><!--//app-card-body-->
              </div><!--//app-card-->
            </div>            
          </div><!--//tab-content-->
        </div><!--//container-fluid-->
      </div><!--//app-content-->
      <%- include('../layout/footer') -%>
    </div><!--//app-wrapper-->
  </div>
  <%- include('../layout/script') -%>
  <script src="/js/letterHead.js"></script> 
</body>
</html>

<!-- -------------------------------------------------------------------------------------------- -->

<div class="modal modal-container1" tabindex="-1" role="dialog" id="letterModalDialog" >
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" style="font-weight: bold;">Add Letterhead</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <form enctype="multipart/form-data" id="createLetterHeadForm">
        <div class="item border-bottom py-3">
          <div class="row justify-content-between align-items-center row-6">
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Letterhead Number<span class="requiredField">*</span></strong></div>
                  <div class="item-data">
                    <input id="letterHeadNumber" class="form-control" placeholder="Letterhead Number" required type="text">
                  </div> <!-- form-group// -->
                </div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Issuer Name<span class="requiredField">*</span></strong></div>
                  <div class="item-data">
                    <input id="issuerName" class="form-control" placeholder="Issuer Name" required type="text">
                  </div> <!-- form-group// -->
                </div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="col-auto">
              <div class="mb-3">
                <div class="item-label"><strong>Issue To<span class="requiredField">*</span></strong></div>
                  <div class="item-data">
                    <input id="issueTo" class="form-control" placeholder="Issue To" required type="text">
                  </div> <!-- form-group// -->
              </div>
              </div>
            </div>		
          </div><!--//row-->
        </div><!--//item-->
        <div class="item border-bottom py-3">
          <div class="row justify-content-between align-items-center row-6">
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Issue Date<span class="requiredField">*</span></strong></div>
                  <div class="item-data">
                    <input id="issueDate" class="form-control" required type="date">
                  </div> <!-- form-group// -->
                </div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Letterhead Type<span class="requiredField">*</span></strong></div>
                  <div class="item-data">
                    <select id="letterheadType" required class="form-control form-select"></select>
                  </div> <!-- form-group// -->
                </div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="col-auto">
              <div class="mb-3">
                <div class="item-label"><strong>Reason</strong></div>
                  <div class="item-data">
                    <textarea id="reason" placeholder="Reason" style="height: 87px !important;" class="form-control"></textarea>
                  </div> <!-- form-group// -->
              </div>
              </div>
            </div>		
          </div><!--//row-->
        </div><!--//item-->
        <div class="item border-bottom py-3">
          <div class="row justify-content-between align-items-center row-6">
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Upload Document<span class="requiredField">*</span></strong></div>
                  <div class="item-data">
                    <input type="file" accept="image/*, .pdf" id="letterHeadDocument" class="form-control">
                  </div> <!-- form-group// -->
                </div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="col-auto">
                <div class="mb-3">
                  <div class="item-label"><strong>Note</strong></div>
                  <div class="item-data">
                    <textarea id="note" placeholder="Note" style="height: 87px !important;" class="form-control"></textarea>
                  </div> <!-- form-group// -->
                </div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="col-auto">
              <div class="mb-3">
                <div class="item-label"><strong></strong></div>
              </div>
              </div>
            </div>		
          </div><!--//row-->
        </div><!--//item-->
       </form>
        <div class="modal-footer">
          <button type="submit" onclick="$.fn.addLetterHeadFuc()" class="btn btn-primary">Save</button>
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- -------------------------------------------------------------------------------------------- -->

