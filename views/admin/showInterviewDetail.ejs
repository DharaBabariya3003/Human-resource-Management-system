<!DOCTYPE html>
<html lang="en">
<head>
<!-- Import Head -->
<%- include('../layout/head') -%>   
</head>	
<body>
<%- include('../layout/header') -%>   
<div class="app">   	
  <div class="app-wrapper">
	  <div class="app-content pt-3 p-md-3 p-lg-4">
		  <div class="container-xl">			    
			  <div class="row g-3 mb-4 align-items-center justify-content-between">
				  <div class="col-auto">
			      <h1 class="app-page-title mb-0">Interview Candidate Details</h1>
				  </div>
			  </div><!--//row-->			   				                    
				<div class="app-card app-card-orders-table shadow-sm mb-5 card-neumorphic">
					<div class="app-card-body">
						<div class="col-12 col-lg-12">
              <div class="app-card-header p-3 border-bottom-0">
                <div class="row align-items-center gx-3">
                  <div class="col-auto">  
                    <div class="app-icon-holder">
                    	<svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-person" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  			<path fill-rule="evenodd" d="M10 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm6 5c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                			</svg>
                    </div><!--//icon-holder-->                                                          
                  </div><!--//col-->                                                                                                        
                	<div class="col-auto">
                    <h4 class="app-card-title">Profile</h4>
                  </div><!--//col-->
                  <div class="col text-right" style="position:absolute; right:0;">
                    <a class="btn btn-success btn-green-neumorpic" href="/admin/interview/<%= oldValues._id %>/edit">
                      Edit Profile
                    </a>
                  </div>
                </div><!--//row-->
              </div><!--//app-card-header-->
            </div><!--//col-->						        						       
            <div class="col-12 col-lg-12">
              <div class="app-card-header p-3 border-bottom-0">
                <div class="row align-items-center gx-3">
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6" style="padding-left: 26px;">
                        <div class="item-label"><strong>Full Name</strong></div>
                        <div class="item-data">
                          <%= oldValues.name %>
                        </div>
                      </div><!--//col-->
                      <div class="col-sm-6">
                        <div class="item-label"><strong>Birth Date</strong></div>
                        <div class="item-data"><%if(oldValues.dateOfBirth){%>
                          <%= oldValues.moment(oldValues.dateOfBirth).format("DD MMM YYYY") %></div>
                        <%}else{%>
                          &nbsp;
                        <%}%></div>
                      </div><!--//col-->
                    </div><!--//row-->
                  </div><!--//item-->
              <div class="item border-bottom py-3">
                <div class="row justify-content-between align-items-center">
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Address / Location</strong></div>
                    <div class="item-data">
                      <%= oldValues.address %>
                    </div>
                  </div><!--//col-->
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Email</strong></div>
                    <div class="item-data"><%= oldValues.email %></div>
                  </div><!--//col-->
                </div><!--//row-->
              </div><!--//item-->
              <div class="item border-bottom py-3">
                <div class="row justify-content-between align-items-center">
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Previous Company Name</strong></div>
                    <div class="item-data">
                      <%= oldValues.previousCompanyName %>                                                             
                    </div>
                  </div><!--//col-->
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Year of Experience</strong></div>
                    <div class="item-data">
                      <%= oldValues.yearOfExperience %>                                                            
                    </div>
                  </div><!--//col-->                                                        
                </div><!--//row-->
              </div><!--//item-->
              <div class="item border-bottom py-3">
                <div class="row justify-content-between align-items-center">
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Current Salary</strong></div>
                    <div class="item-data">
                      <%= oldValues.currentSalary %>
                    </div>
                  </div><!--//col-->
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Expected Salary</strong></div>
                    <div class="item-data">
                      <%= oldValues.expectedSalary %>
                    </div>
                  </div><!--//col-->
                </div><!--//row-->
              </div><!--//item-->
              <div class="item border-bottom py-3">
                <div class="row justify-content-between align-items-center">                                                       
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Qualification</strong></div>
                    <div class="item-data">
                      <%= oldValues.qualification %>
                    </div>
                  </div><!--//col-->
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Technology</strong></div>
                    <div class="item-data">
                      <%= oldValues.technology %>
                    </div>
                  </div><!--//col-->
                </div><!--//row-->
              </div><!--//item-->
              <div class="item border-bottom py-3">
                <div class="row justify-content-between align-items-center">
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Interview Date</strong></div>
                    <div class="item-data">                                                                
                      <%= oldValues.moment(oldValues.interviewTime).format("DD MMM YYYY") %>
                    </div>
                  </div><!--//col-->
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Interview Time</strong></div>
                    <div class="item-data">
                      <span id="displayLocalInterviewTime" ><%= oldValues.interviewTime %></span>
                    </div>
                  </div><!--//col-->
                </div><!--//row-->
              </div><!--//item-->
              <div class="item border-bottom py-3">
                <div class="row justify-content-between align-items-center">
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Call Date</strong></div>
                    <div class="item-data">
                      <%if(oldValues.callDate){%>
                        <%= oldValues.moment(oldValues.callDate).format("DD MMM YYYY") %>
                      <%}%>
                    </div>
                  </div><!--//col-->
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Contact number</strong></div>
                    <div class="item-data">
                      <%if(!oldValues.contactNumber=='0')
                      {%>
                        <%= oldValues.contactNumber %>
                      <%}%>                                                                
                    </div>
                  </div><!--//col-->
                </div><!--//row-->
              </div><!--//item-->
              <div class="item border-bottom py-3">
                <div class="row justify-content-between align-items-center">
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Interview Status</strong></div>
                    <div class="item-data">
                      <%if(oldValues.interviewStatus){%>
                        <%= "Done" %>
                      <%}else{%>
                        <%= "Pending" %>
                      <%}%>
                    </div>
                  </div><!--//col-->
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Interview Mode</strong></div>
                    <div class="item-data">
                      <%= oldValues.interviewMode %>
                    </div>
                  </div><!--//col-->
                </div><!--//row-->
              </div><!--//item-->
              <div class="item border-bottom py-3">
                <div class="row justify-content-between align-items-center">
                  <div class="col-sm-6">
                    <div class="item-label"><strong>practical Test Status</strong></div>
                    <div class="item-data">
                      <%if(oldValues.practicalTestStatus){%>
                        <%= "Done" %>
                      <%}else{%>
                        <%= "Pending" %>
                      <%}%>
                    </div>
                  </div><!--//col-->
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Communication skill(Out of 10)</strong></div>
                    <div class="item-data">
                      <%= oldValues.communicationSkill %>
                    </div>
                  </div><!--//col-->                                                      
                </div><!--//row-->
              </div><!--//item-->
              <div class="item border-bottom py-3">
                <div class="row justify-content-between align-items-center">
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Confidence/Body language(Out of 10)</strong></div>
                    <div class="item-data">                                                                
                      <%= oldValues.confidenceOrBodyLang %>                                                              
                    </div>
                  </div><!--//col-->
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Logical skills(Out of 10)</strong></div>
                    <div class="item-data">
                      <%= oldValues.logicalSkills %>
                    </div>
                  </div><!--//col-->                                                      
                </div><!--//row-->
              </div><!--//item-->
              <div class="item border-bottom py-3">
                <div class="row justify-content-between align-items-center">
                  <div class="col-sm-6">
                    <div class="item-label"><strong>HR Round User Name</strong></div>
                    <div class="item-data">
                      <%= oldValues.hrRoundUser.firstName+" "+oldValues.hrRoundUser.middleName+" "+oldValues.hrRoundUser.lastName %>
                    </div>
                  </div><!--//col-->
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Technical Round User Name</strong></div>
                    <div class="item-data">
                      <%= oldValues.technicalRoundUser.firstName+" "+oldValues.technicalRoundUser.middleName+" "+oldValues.technicalRoundUser.lastName %>
                    </div>
                  </div><!--//col-->
                </div><!--//row-->
              </div><!--//item-->
              <div class="item border-bottom py-3" style="border-bottom: none !important;">
                <div class="row justify-content-between align-items-center">
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Remark</strong></div>
                    <div class="item-data">
                      <%= oldValues.remark %>
                    </div>
                  </div><!--//col-->
                  <div class="col-sm-6">
                    <div class="item-label"><strong>Reference User Name</strong></div>
                    <div class="item-data">
                      <%if(oldValues.referenceUser){%>
                        <%= oldValues.referenceUser.firstName+" "+oldValues.referenceUser.middleName+" "+oldValues.referenceUser.lastName %>
                      <%}%>
                    </div>
                  </div><!--//col-->
                </div><!--//row-->
              </div><!--//item-->
              </div></div>
            </div>
					</div><!--//app-card-body-->		
				</div><!--//app-card-->
		</div><!--//container-fluid-->
	</div><!--//app-content-->
	<%- include('../layout/footer') -%>
</div><!--//app-wrapper-->
   
 <%- include('../layout/script') -%>   
 <script>
   $(document).ready(function () {
    var startTime = $("#displayLocalInterviewTime").text();
    document.getElementById('displayLocalInterviewTime').textContent = moment.utc(new Date(startTime)).local().format("hh:mm A");
  });
 </script>
</body>
</html>

 
    

