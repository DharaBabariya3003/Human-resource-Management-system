  // Add event listener for opening and closing details
  $('#monthlyAttendanceTable').on('click', 'td.details-control', function () {
    var tr = $(this).closest('tr');
    let a = document.getElementById("attendanceLogsRecord").textContent;		
		let b =  tr.find(".attendanceDate").text(); 
		let c = document.getElementById("attendanceLogCapture").textContent;
		a = JSON.parse(a);    
		
    var row = table.row(tr);               
    if (row.child.isShown()) {
        // This row is already open - close it
        row.child.hide();
        tr.removeClass('shown');
    } else {
        // Open this row
        row.child(format(a,b,c)).show(); 
        tr.addClass('shown');
    }
  });
	
	});
	function format(attendancelogs,date,attendanceLogCapture) {
	let loggedUserInfo = document.getElementById('loggedUser').value;
	
  let a = 0;
  let j = 0;
  let start = '<table cellpadding="5" cellspacing="0" border="0" style="padding-left:50px;background-color:#f6f8fe;width: 100%;font-size:13px">';
  let end = '</table>' ;
	let flag = 0; 
	let convert =	JSON.parse(JSON.stringify(attendanceLogCapture));
	attendanceLogCapture = JSON.parse(convert);

	let tableHeader;
	let tableHeaderUp = `<tr>
            <th><strong>Sr No.</strong></th>
            <th><strong>In Time</strong></th>
            <th><strong>Out Time</strong></th>
            <th><strong>Total Time</strong></th>
            <th><strong>Late Reason</strong></th>
            <th><strong>Leave Reason</strong></th>
            <th><strong>Overtime Reason</strong></th>
            <th><strong>Updated Reason</strong></th>
	<th><strong>Action</strong></th>`;
	let tableHeaderMiddle = `<th><strong>Delete</strong></th>`;
	let tableHeaderBottom = `<th><strong>Entry</strong></th>
	<th><strong>Exit</strong></th>
        </tr>`

	if(loggedUserInfo == 'admin'){
		tableHeader = tableHeaderUp + tableHeaderMiddle + tableHeaderBottom;
	}else{
		tableHeader = tableHeaderUp +  tableHeaderBottom;
	}

  for(i = 0; i < attendancelogs.length; i++){  

		let startCapture;
		let endCapture;
		for(let j = 0; j < attendanceLogCapture.length; j++){			
			if((attendanceLogCapture[j].attendanceLogId == attendancelogs[i]._id) && attendanceLogCapture[j].captureType == "Entry"){				
				startCapture = attendanceLogCapture[j].key;
			}else if((attendanceLogCapture[j].attendanceLogId == attendancelogs[i]._id) && attendanceLogCapture[j].captureType == "Exit"){
				endCapture = attendanceLogCapture[j].key;
			}
		}
		if(!startCapture){
			startCapture = "/assets/images/no-capture.png";
		}	
		if(!endCapture){
			endCapture = "/assets/images/no-capture.png";
		}
    let logDate = new Date(attendancelogs[i].createdAt).toDateString();
    if(logDate.trim() === date.trim()){
			let totalTime = "-";
      let printEndTime = '-';
      let lateReason ="-";      
      let leaveReason="-";
      let overtimeReason="-";
			let updateReson ="-";
			let mode ="-";
      if(attendancelogs[i].updateRecord[0]){
        updateReson = attendancelogs[i].updateRecord[0].updateReason;
        for(let j = 1;j < attendancelogs[i].updateRecord.length ;j++)
        {
          updateReson = updateReson +"<br>"+ attendancelogs[i].updateRecord[j].updateReason;
        }      
      }
      if(attendancelogs[i].lateReason){
        lateReason = attendancelogs[i].lateReason;
      }
      if(attendancelogs[i].leaveReason){
        leaveReason = attendancelogs[i].leaveReason;
      }
      if(attendancelogs[i].overtimeReason){
        overtimeReason = attendancelogs[i].overtimeReason;
      }
      if(attendancelogs[i].endTime) {
				printEndTime = interviewTimeToHours(getLocalTime(attendancelogs[i].endTime));
				let endTime,startTime;
				if(attendancelogs[i].attendanceMode.trim() == 'Card'){
					startTime = moment.duration(getUtcHnM(attendancelogs[i].startTime), "HH:mm ");
					endTime = moment.duration(getUtcHnM(attendancelogs[i].endTime), "HH:mm ");
					let diff = endTime.subtract(startTime);
					let diffH = diff.hours(); 
					let diffM = diff.minutes();
					totalTime =  diffH + ":" + diffM;
				}else{
					endTime = moment(attendancelogs[i].endTime);
					startTime = moment(attendancelogs[i].startTime);
					let minuteDiffBtnLog = endTime.diff(startTime, 'minutes');
					let minutesToHours = ((Math.floor(minuteDiffBtnLog / 60) + ':' + minuteDiffBtnLog % 60));
					totalTime =  minutesToHours;
				}
			}
			
			let trRowsVal;

			let trRowsUpVal = `<tr style="border-bottom:2px solid gray">
            <td><strong>${(j=j+1)}</strong></td>
            <td>${interviewTimeToHours(getLocalTime(attendancelogs[i].startTime))}</td>
            <td>${printEndTime}</td>
            <td>${formatTotalTime(totalTime)}</td>
            <td>${lateReason}</td>
            <td>${leaveReason}</td> 
            <td>${overtimeReason}</td>
            <td>${updateReson}</td>
			<td> <button type="button" onclick='attendanceDateHandlerEmployeeShowupdate(${JSON.stringify(attendancelogs[i]._id)})' class="btn btn-outline-success btn-round-green-neumorpic" data-toggle="tooltip" title="Edit" style="border-radius: 0%;" data-id=id><i class="fas fa-edit"></i></button> </td> `;
			let trRowsMiddleVal = `<td> <button type="button" onclick="$.fn.deleteAttendanceLog('${attendancelogs[i]._id}','${attendancelogs[i].user}','${date}');" class="btn btn-outline-danger btn-round-red-neumorpic" data-toggle="tooltip" title="Delete"><i class="fas fa-trash-alt"></i></button> </td>`;
			let trRowsBottomVal = `<td>
							<a data-fancybox="gallery" href="${startCapture}">																									
								<img id="imagepreviewofferLetter" class="round-border" src="${startCapture}"/>	
							</a>
						</td>
						<td>
							<a data-fancybox="gallery" href="${endCapture}">																									
								<img id="imagepreviewofferLetter" class="round-border" src="${endCapture}"/>	
							</a>
						</td>
					</tr>`;
			if(loggedUserInfo == 'admin'){
				trRowsVal = trRowsUpVal + trRowsMiddleVal + trRowsBottomVal;
			}else{
				trRowsVal = trRowsUpVal  + trRowsBottomVal;
			}
      if(flag == 0){
				a = trRowsVal;
				flag = 1;
      }else{
        a = a + trRowsVal;
      }                   
    }
  }
  if(a == 0) return start + "<h6><strong>No logs found...</strong></h6>" + end;
  let finalTable = start + tableHeader + a + end;
  return finalTable;
}
	function convertIntime(intime){
	let result ;
	if(intime){	
		var s = intime.trim();		
		if(s !== "-"){
			result= (interviewTimeToHours(getLocalTime(s)));
		}else{
			result = "-";
		}
	}else{
		result = "-";
	}
	return result;
	
}
	function convertOuttime(outtime){
	let result ;
	if(outtime){
		var e = outtime.trim();	
		if(e !== "-"){
			result= (interviewTimeToHours(getLocalTime(e)));
		}else{
			result = "-";
		}
	}else{
		result = "-";
	}
	
	return result;
}
function convertTotaltime(totaltime, endTime, inTime){	
	let result;
	let startLocalTime;
	//for inTime
	if(inTime){
		var s = inTime.trim();			
		if(s !== "-"){
			startLocalTime = getLocalTime(s);		
		}
	}
	
	//for outTime	
	let e ;
	if(endTime){
		e = endTime.trim();	
		if(e !== "-"){
			e = (interviewTimeToHours(getLocalTime(e)));
		}else{
			e = "-";
		}
	}else{
		e = "-";
	}
	
	//for totalTime
	let t = totaltime.trim();
	var hours,minutes;
			if(t !== "-"){
				if(e !== "-"){
				t=t.split(":");

				if(t[0].length==1){	
					hours = format_two_digits(parseInt(t[0]));
				}else{
					hours = t[0];
				}

				if(t[1].length==1){
					minutes = format_two_digits(parseInt(t[1]));
				}else{
					minutes = t[1];
				}
			  result = (hours+":"+minutes)
				}else{
					let currentDate = moment(inTime).isSame(moment(), 'day');
					if(currentDate){
					let currentTime = moment().format("HH:mm");
					let workingHourss = getTimeDiff(startLocalTime,currentTime);
					result = workingHourss;
					}else{
						return "-";
					}
				}
			}else{
				result = '-';
			}
			return result;
}

</script>


