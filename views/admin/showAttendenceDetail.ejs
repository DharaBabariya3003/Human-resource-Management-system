<script>
	function getTimeDiff(startTime,endTime){
  let workingHours;
  let entryTime = moment.duration(startTime, "HH:mm ");
  let exitTime = moment.duration(endTime, "HH:mm ");
  let diff = exitTime.subtract(entryTime);
  let diffH = diff.hours();
  let diffM = diff.minutes();
  if(diffH<0 || diffM<0){
    workingHours = "-";
  }else{
    diffH = format_two_digits(diff.hours());
    diffM = format_two_digits(diff.minutes());
    workingHours = diffH + ":" + diffM;
  }
  return workingHours ;
	}
	function format_two_digits(n) {
		return n < 10 ? '0' + n : n;
	}
	function getLocalTime(dateAndTime) {
		let localTime = moment.utc(dateAndTime).local().format(); 
		let localHours = new Date(localTime).getHours();
		let localMinutes = new Date(localTime).getMinutes();
		let localH = format_two_digits(localHours);
		let localM = format_two_digits(localMinutes);
		
		let localHnM = localH+":"+localM ;	
		return localHnM ;
	}
	(function() {
    'use strict';
    // Your code here...
    $("tbody").find("tr").each(function() {

		var startTd = $(this).find('td.startTimeClass');
		var endTd = $(this).find('td.endTimeClass');
		var totalTime = $(this).find('td.totalTimeClass');

		var s = startTd.text();
		var e = endTd.text();
		var t = totalTime.text();
		
		s = s.trim();
		e = e.trim();
		t = t.trim();

		let startLocalTime;
			if(s !== "-"){
				startLocalTime = getLocalTime(s);
				startTd.text(interviewTimeToHours(getLocalTime(s)));
			}else{
				startTd.text("-")
			}

			if(e !== "-"){
				endTd.text(interviewTimeToHours(getLocalTime(e)));
			}else{
				endTd.text("-");
			}

			var hours,minutes;
			if(t !== "-"){
				if(e !== "-"){
				t=t.split(":");

				if(t[0].length==1){
					hours = format_two_digits(parseInt(t[0]));
				}else{
					hours = t[0];
				}

				if(t[1].length==1){
					minutes = format_two_digits(parseInt(t[1]));
				}else{
					minutes = t[1];
				}
				totalTime.text(hours+":"+minutes)
				}else{
					let currentTime = moment().format("HH:mm");
					let workingHourss = getTimeDiff(startLocalTime,currentTime);
					totalTime.text(workingHourss)
				}
			}else{
				totalTime.text('-');
			}
		});
})();

</script>

<script>
