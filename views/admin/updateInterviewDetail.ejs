														<div class="mb-3">
															<div class="item-label"><strong>Birth Date</strong></div>
															<div class="item-data">
																<input name="dateOfBirth" class="form-control" type="text" readonly  <%if(oldValues){
																	if(oldValues.old){
																		if(oldValues.old.loginUserRoleName && oldValues.old.loginUserRoleName == 'user'){%>
																			readonly
																		<%}else{%>
																			id="dateOfBirth"
																		<%}
																	}else{
																		if(oldValues.loginUserRoleName && oldValues.loginUserRoleName == 'user'){%>
																			readonly
																		<%}else{%>
																			id="dateOfBirth"
																		<%}
																	}
																}%> value=<%if(oldValues){
																	if(oldValues.old && oldValues.old.dateOfBirth){%>
																		<%= oldValues.old.dateOfBirth %>
																	<%}else{
																		if(oldValues.dateOfBirth){%>
