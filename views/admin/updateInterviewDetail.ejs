																			if(oldValues.loginUserRoleName && oldValues.loginUserRoleName == 'user'){%>
																				readonly
																			<%}
																		}
																	}%>	 onkeypress="return isNumberKey(event);" placeholder="Expected salary" type="text" value=<%if(oldValues){
																		if(oldValues.old && oldValues.old.expectedSalary){%>
																			<%= oldValues.old.expectedSalary %>
