																			if(oldValues){%>
																				<%- JSON.stringify(oldValues.technicalRoundUser.firstName+" "+oldValues.technicalRoundUser.middleName+" "+oldValues.technicalRoundUser.lastName+" ("+oldValues.technicalRoundUser.attendanceCode+")") %>
																			<%}
																		}
																	}%>>
