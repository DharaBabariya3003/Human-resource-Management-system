																			if(oldValues.loginUserRoleName && oldValues.loginUserRoleName == 'user'){%>
																				readonly
																			<%}
																		}
																	}%>	 onkeypress="return isNumberKey(event);" placeholder="Current salary"  type="text" value=<%if(oldValues){
																		if(oldValues.old && oldValues.old.currentSalary){%>
																			<%= oldValues.old.currentSalary %>
																		<%}else{
																			if(oldValues.currentSalary){%>
																				<%= oldValues.currentSalary %>
																			<%}
																		}
																	}%>>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
