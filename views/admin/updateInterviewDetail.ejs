																				readonly
																			<%}
																		}
																	}%>	 placeholder="Year of experience" value=<%if(oldValues){
																		if(oldValues.old && oldValues.old.yearOfExperience){%>
																			<%- JSON.stringify(oldValues.old.yearOfExperience)%>
																		<%}else{
																			if(oldValues.yearOfExperience){%>
																				<%- JSON.stringify(oldValues.yearOfExperience)%>
																			<%}
																		}
																	}%>>
																</div> <!-- form-group// -->
															</div>
														</div>
													</div>
													<div class="col-sm-4">
														<div class="col-auto">
															<div class="mb-3">
																<div class="item-label"><strong>Current salary</strong></div>
																<div class="item-data">
																	<input name="currentSalary" class="form-control" maxlength="5" <%if(oldValues){
