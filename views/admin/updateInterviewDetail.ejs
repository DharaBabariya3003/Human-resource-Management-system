																							if(element.firstName && element.lastName){%>
																								<option data-value= '<%= element._id %>' value='<%= element.firstName+" "+element.middleName+" "+element.lastName+" ("+element.attendanceCode+")" %>'> </option>
																							<%}
																						})
																					}
																				}
																			}else{
																				if(oldValues){
																					if(oldValues.technicalRound){
																						if(oldValues.technicalRound.length > 0){
																							oldValues.technicalRound.forEach(element=>{
																								if(element.firstName && element.lastName){%>
																									<option data-value= '<%= element._id %>' value='<%= element.firstName+" "+element.middleName+" "+element.lastName+" ("+element.attendanceCode+")" %>'> </option>
																								<%}
																							})
																						}
																					}		
																				}
																			}
																		}%>
