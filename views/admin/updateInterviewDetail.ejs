<script>
function isNumberKey(evt){
	var charCode = (evt.which) ? evt.which : evt.keyCode
  return !(charCode > 31 && (charCode < 48 || charCode > 57));
}
$(document).ready(function () {
	var interviewTime = document.getElementById('interviewTime').value;
	if(interviewTime){
		let timeLength = interviewTime.split(" ");
		timeLength = timeLength.length;
		if(timeLength == 1){
			document.getElementById('interviewTime').value = moment.utc(new Date(interviewTime)).local().format("DD-MM-YYYY hh:mm A");
		}else{
			document.getElementById('interviewTime').value = interviewTime;
		}
	}
});
</script>
