<!DOCTYPE html>
<html lang="en">
<head>
	<!-- Import Head -->
  <%- include('../layout/head') -%>
  <style>
    .hideTd{
      display: none;
    }
  </style>
</head>
<body>
	<div id="load"></div>
	<%- include('../layout/header') -%>
	<div class="app">
			<div class="app-wrapper">
				<div class="app-content pt-3 p-md-3 p-lg-4">
					<div class="container-xl">
						<h1 class="app-page-title">Letterhead Types</h1>
						<hr class="mb-4">
						<div class="row g-4 settings-section" id="appContents">
							<div class="col-12 col-md-12">
								<div class="app-card app-card-settings shadow-sm p-4 card-neumorphic">
									<div class="app-card-body">
                    <div class="item border-bottom py-3" style="border: none !important;">
                      <div class="row justify-content-between align-items-center row-6">
                        <div class="col-sm-5">
                          <div class="col-auto">
                            <div class="mb-3">
                              <div class="item-label">
                                <strong>Letterhead Type:<span class="requiredField">*</span></strong>
                              </div>
                              <div class="item-data">
                                <input type="text" required class="form-control" id="letterheadType" placeholder="Letterhead Type">
                              </div><!-- form-group// -->
                            </div>
                          </div>
                        </div>
                        <div class="col-sm-7">
                          <div class="col-auto">
                            <div class="mb-3">
                              <div class="item-label"><strong>&nbsp;</strong></div>
                              <div class="item-data">
                                <button type="submit" class="btn app-btn-primary btn-green-neumorpic" onclick="$.fn.addLetterheadTypeFuc()" style="border-radius: 0;">Add Letterhead Type</button>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div><!--//row-->
                    </div>
                    <div class="tab-content" id="orders-table-tab-content">
                      <div class="app-card app-card-orders-table shadow-sm mb-5 card-neumorphic">
                        <div class="app-card-body">
                          <table id="showLetterHeadTypesTable" class="table app-table-hover mb-0 text-left">
                            <thead>
                              <tr>
                                <th class="cell">Sr No</th>
                                <th style="display: none;"></th>
                                <th class="cell">Letterhead Type</th>
                                <th class="cell">Edit</th>
                              </tr>
                            </thead>
                            <tbody>
                            </tbody>
                          </table>
                        </div><!--//app-card-body-->
                      </div><!--//app-card-->
                    </div><!--//tab-content-->
									</div><!--//row-->
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div><!--//container-fluid-->
	</div>	<!--//app-content-->
	<%- include('../layout/footer') -%>
</div><!--//app-wrapper-->
<%- include('../layout/script') -%>
<script src="/js/letterHeadType.js"></script>
</body>
</html>