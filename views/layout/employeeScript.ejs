<!-- Toaster files -->
<script src="/assets/toastr/toastr.min.js"></script>      

<script>
$(document).ready(function(){
	
		$('[data-toggle="tooltip"]').tooltip();
	
		$(".data-table").DataTable({
        "responsive": true,
        "order": [[ 0, "desc" ]], 
        "autoWidth": false,
		});
		
    $(".asc-data-table").DataTable({
        "responsive": true,
        "order": [[ 0, "asc" ]], 
        "autoWidth": false
		});
		
});

</script>
<% if (error) { %>
	<script>
		toastr.error('<%- error.message %>');
	</script>
<% } %>

