<!DOCTYPE html>
<html lang="en">
<head>
	<!-- Import Head -->
	<%- include('layout/head') -%>
</head>
<body>
	<div class="app app-login p-0">
		<div class="row g-0 app-auth-wrapper">
			<div class="col-12 col-md-7 col-lg-6 auth-main-col text-center p-5">
				<div class="d-flex flex-column align-content-end">
					<div class="app-auth-body mx-auto">
						<div class="app-auth-branding mb-4"><a class="app-logo" href="#">
							<img class="mr-2 logoFormat" src="/assets/images/background/bigscal-logo.png" alt="logo"></a></div>
						<h2 class="auth-heading text-center mb-5 loginFont">Change password</h2>
						<div class="auth-form-container text-left">
							<form class="auth-form resetpass-form" id="changePswForm" method="POST" action="/dashboard/change-password">
								<div class="email mb-3">
									<input name="id" type="hidden" value=<%if(typeof userID !== 'undefined'){
										if(typeof userID === 'string'){
											if(userID){%>
												<%= userID %>
											<%}else{%>
												<%= "123" %>
											<%}
										}else{%>
											<%= "123" %>
										<%}
									}else{%>
										<%= "123" %>
									<%}%>>
								<input name="newPassword" id="newPassword" type="password" class="form-control login-email" placeholder="New password" 
								 value="" ><br>
								 <input type="password" name="newConfirmPassword" id="confirmNewPassword" class="form-control login-email" placeholder="Confirm new password"
								value="">
								</div>
								<!--//form-group-->
								<div class="text-center">
									<button type="submit" class="btn app-btn-primary btn-block theme-btn mx-auto" id="changePassword">Change Password</button>
								</div>
							</form>
							<div class="auth-option text-center pt-5">
								<div id="passwordError"></div>
							</div>
							<div class="auth-option text-center pt-5"><a class="app-link" href="/auth/login">Log in</a> <span
									class="px-2">|</span> <a class="app-link" href="#">Sign up</a></div>
						</div>
			<!--//auth-form-container-->
     </div>
     <!--//auth-body-->
     <%- include('layout/footer') -%>
    </div>
				<!--//flex-column-->
			</div>
			<!--//auth-main-col-->
			<div class="col-12 col-md-5 col-lg-6 h-100 auth-background-col">
				<div class="auth-background-holder">
				</div>
				<div class="auth-background-mask"></div>
				<div class="auth-background-overlay p-3 p-lg-5">
					<div class="d-flex flex-column align-content-end h-100">
						<div class="h-100"></div>
						<div class="overlay-content p-3 p-lg-4 rounded">
							<h5 class="mb-3 overlay-title">Bigscal Technologies Pvt Ltd.</h5>
							<div>
								We are a leading custom software development company providing world-magnificence software program development offerings primarily based totally on years of experience, a group of certified professionals, key enterprise insights, and dedicated workflows.
							</div>
						</div>
					</div>
				</div>
				<!--//auth-background-overlay-->
			</div>
   <!--//auth-background-col-->
  </div>
		<!--//row-->
	</div>
	<%- include('./layout/externalScript') -%>
</body>
<script>
	$(document).ready(function () {
		let newpassword = $("#newPassword").val();
		let confirmnewPassword = $("#confirmNewPassword").val();
		if(!newpassword || !confirmnewPassword){
			document.getElementById("changePassword").disabled = true;
		}
});
	$.fn.comparePassword = function(){ 
		let newpassword = $("#newPassword").val();
		let confirmnewPassword = $("#confirmNewPassword").val();
		if (newpassword != confirmnewPassword) {
      $("#passwordError").html("**Password and confirm password are not matching");
			$("#passwordError").css({ color: "red", "font-weight": "bold" });
			document.getElementById("changePassword").disabled = true;
      return false;
    } else {
			$("#passwordError").html("");
			document.getElementById("changePassword").disabled = false;
      return true;
    }  
  }
	$("#newPassword").keyup(function () {
		let confirmnewPassword = $("#confirmNewPassword").val();
		if(confirmnewPassword){
			$.fn.comparePassword();
		}else{
			document.getElementById("changePassword").disabled = true;
		}
	});
	$("#confirmNewPassword").keyup(function () {
		let newpassword = $("#newPassword").val();
		if(newpassword){
		$.fn.comparePassword();
		}else{
			document.getElementById("changePassword").disabled = true;
		}
  });
	$("#changePassword").on("click", function(event) {
		event.preventDefault();
		setTimeout(
        function(){
            $("#changePswForm").submit();
        },2000);
	});
</script>
</html>