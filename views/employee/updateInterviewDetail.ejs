<script>
function isNumberKey(evt){
	var charCode = (evt.which) ? evt.which : evt.keyCode
  return !(charCode > 31 && (charCode < 48 || charCode > 57));
}
$(document).ready(function() {
	var data = {}; 
	$("#encodings option").each(function(i,el) {  
		data[$(el).data("value")] = $(el).val();
	});
	$('#interviewerName').blur(function(){
		var value = $('#interviewerName').val();
		var userId = $('#encodings [value="' + value + '"]').data('value');
		if(!userId){
			$('#interviewerCode').val("");
			return false;
		}else{
			$('#interviewerCode').val(userId);
		}
		getAttendanceCode();
	});
	$('#interviewerName').keydown(function(){
		$('#interviewerCode').val("");
	});
	var today = new Date();
	var dd = today.getDate();
	var mm = today.getMonth()+1; //January is 0 so need to add 1 to make it 1!
	var yyyy = today.getFullYear();
	if(dd<10){
		dd='0'+dd
	}
	if(mm<10){
		mm='0'+mm
	}
	today = yyyy+'-'+mm+'-'+dd;
	document.getElementById("attendanceDate").setAttribute("max", today);  	
	});
</script>
