<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Import Head -->
    <%- include('../layout/head') -%>
  </head>
  <body>
    <% userID = oldValues.userUpdateRecords._id.toString() %>
    <% data= null %>
    <% if(oldValues.userProfileImage){
      data = oldValues.userProfileImage;}else{
      data = null; }
    %>
    <%- include('../layout/employeeHeader') -%>
    <div class="app">
      <div class="app-wrapper">
        <div class="app-content pt-3 p-md-3 p-lg-4">
          <div class="container-xl">
            <div class="row g-3 mb-4 align-items-center justify-content-between">
              <div class="col-auto">
                <h1 class="app-page-title mb-0">Employee Details</h1>
              </div>
              <div class="col-auto">
                <div class="page-utilities">
                  <div class="row g-2 justify-content-start justify-content-md-end align-items-center">
                    <div class="col-auto"></div>
                    <!--//col-->
                  </div>
                  <!--//row-->
                </div>
                <!--//table-utilities-->
              </div>
              <!--//col-auto-->
            </div>
            <!--//row-->
            <div class="app-card-body">
              <% if(oldValues.userUpdateRecords) {%>
              <div class="app-card app-card-account shadow-sm d-flex flex-column align-items-start card-neumorphic">
                <div class="app-card-header p-3 border-bottom-0">
                  <div class="row align-items-center gx-3">
                    <div class="col-auto">
                      <div class="app-icon-holder">
                        <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-person" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                          <path fill-rule="evenodd" d="M10 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm6 5c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                        </svg>
                      </div>
                      <!--//icon-holder-->
                    </div>
                    <!--//col-->
                    <div class="col-auto">
                      <h4 class="app-card-title">Profile</h4>
                    </div>
                    <!--//col-->
                  </div>
                  <!--//row-->
                </div>
                <!--//app-card-header-->
                <div class="app-card-body px-4 w-100">
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-auto">
                        <div class="item-label mb-2">
                          <strong>Photo</strong>
                        </div>
                        <%if(oldValues.userProfileImage){%>
                        <div class="item-data">
                          <a data-fancybox="gallery" href="<%- oldValues.userProfileImage %>">
                            <img class="profile-image" src="<%= oldValues.userProfileImage %>" alt="profile" style="border-radius: 50%" />
                          </a>
                        </div>
                        <%}else{%>
                        <div class="item-data">
                          <img class="profile-image" src="/assets/images/profiles/noProfile.jpg" alt="profile" style="border-radius: 50%" />
                        </div>
                        <%}%>
                      </div>
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Attendance Code</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.attendanceCode %>
                        </div>
                      </div>
                      <!--//col-->
                    </div>
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center row-6">
                      <div class="col-sm-6">
                        <div class="item-label"><strong>Full Name</strong></div>
                        <div class="item-data">
                          <%=oldValues.userUpdateRecords.firstName+" "+oldValues.userUpdateRecords.middleName+" "+oldValues.userUpdateRecords.lastName%>
                        </div>
                      </div>
                      <!--//col-->
                      <div class="col-sm-6">
                        <div class="item-label"><strong>Email-ID</strong></div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.email %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Birth Date</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.moment(oldValues.userUpdateRecords.birthDate).format("DD MMM YYYY"); %>
                        </div>
                      </div>
                      <div class="col-sm-6">
                        <div class="item-label"><strong>Gender</strong></div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.gender %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Contact Number</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.contactNumber %>
                        </div>
                      </div>
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Emergency Contact Number</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.emergencyContactNumber %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Correspondence Address</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.correspondenceAddress %>
                        </div>
                      </div>
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Permanent Address</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.permanentAddress %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Marital Status</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.status %>
                        </div>
                      </div>
                      <!--//col-->
                      <% if(oldValues.userUpdateRecords.status==='Married' ) {%>
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Marriage date</strong>
                        </div>
                        <div class="item-data">
                          <%if(oldValues.userUpdateRecords){
                          if(oldValues.userUpdateRecords.marriageDate){%>
                            <%= oldValues.moment(oldValues.userUpdateRecords.marriageDate).format("DD MMM YYYY"); %> <%} }%>
                        </div>
                      </div>
                      <!--//col-->
                      <%}%>
                    </div>
                    <!--//row-->
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Designation</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.designation.designationName %>
                        </div>
                      </div>
                      <!--//col-->
                      <div class="col-sm-6">
                        <div class="item-label"><strong>Position</strong></div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.position %>
                        </div>
                      </div>
                      <!--//col-->
                    </div>
                    <!--//row-->
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Department Name</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.department.departmentName %>
                        </div>
                      </div>
                      <!--//col-->
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Vehicle Number</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.vehicalNumber %>
                        </div>
                      </div>
                      <!--//col-->
                    </div>
                    <!--//row-->
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label"><strong>Degree</strong></div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.degree %>
                        </div>
                      </div>
                      <!--//col-->
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>College Name</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.collegeName %>
                        </div>
                      </div>
                      <!--//col-->
                    </div>
                    <!--//row-->
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Year Of Passing</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.YearOfPassing %>
                        </div>
                      </div>
                      <!--//col-->
                      <div class="col-sm-6">
                        <div class="item-label"><strong>Bank Name</strong></div>
                        <div class="item-data">
                          <%= oldValues?.userUpdateRecords?.bankId?.bankName %>
                        </div>
                      </div>
                      <!--//col-->
                    </div>
                    <!--//row-->
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Account Number</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.accountNumber %>
                        </div>
                      </div>
                      <!--//col-->
                      <div class="col-sm-6">
                        <div class="item-label"><strong>IFSC Code</strong></div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.ifscCode %>
                        </div>
                      </div>
                      <!--//col-->
                    </div>
                    <!--//row-->
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Account Holder Name</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.accountHolderName %>
                        </div>
                      </div>
                      <!--//col-->
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Office entry time</strong>
                        </div>
                        <div class="item-data">
                          <span id="profile_OfficeEntryTime_Id">
                            <%= oldValues.userUpdateRecords.officeStartTime %>
                          </span>
                        </div>
                      </div>
                    </div>
                    <!--//row-->
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Office exit time</strong>
                        </div>
                        <div class="item-data">
                          <span id="profile_officeEndTime_Id">
                            <%= oldValues.userUpdateRecords.officeEndTime%>
                          </span>
                        </div>
                      </div>
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Total minutes</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.totalMinutes %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Ask late entry reason from</strong>
                        </div>
                        <div class="item-data">
                          <span id="profile_lateReasonMinute_Id">
                            <%= oldValues.userUpdateRecords.lateReasonMinute%>
                          </span>
                        </div>
                      </div>
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Consider over time after minutes</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.overTimeMinute %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Attendance Type</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.attendanceType %>
                        </div>
                      </div>
                      <div class="col-sm-6">
                        <div class="item-label"><strong>consider overtime?</strong></div>
                        <div class="item-data">																	 
                          <%if(oldValues.userUpdateRecords.overtime){%>
                            <%= 'Yes' %>
                          <%}else{%>
                            <%= 'No' %>
                          <%}%>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!--//item-->
                  <div class="item border-bottom py-3">
                    <div class="row justify-content-between align-items-center">
                      <div class="col-sm-6">
                        <div class="item-label">
                          <strong>Organization Type</strong>
                        </div>
                        <div class="item-data">
                          <%= oldValues.userUpdateRecords.organizationType %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!--//item-->
                </div>
                <!--//app-card-body-->
              </div>
              <!--//app-card-->
              <% }%><!--//col-->
            </div>
            <!--//app-card-body-->
          </div>
          <!--//container-fluid-->
        </div>
        <!--//app-content-->
        <%- include('../layout/footer') -%>
      </div>
      <!--//app-wrapper-->
    </div>
    <%- include('../layout/employeeScript') -%>
    <script src="/js/employeeDashBoardUTC.js"></script>
  </body>
</html>
