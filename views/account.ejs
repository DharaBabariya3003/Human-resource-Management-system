				"scrollX": true,
				"order": [[ 0, 'asc' ]],
				"serverSide": true,
				"ordering": false,
				"serverMethod": 'get',
				"bDestroy": true,
				'ajax': {
					'url': '/admin/api/overtimeRecords',			
					'data': function (data) {					
						var overtimeCheckUserId = $('#overtimeCheckUserId').text();
						var checkStatus = $('#checkStatus').text();
						let userIDForOvertime = document.getElementById("userIDForOvertime").value;
						let attendanceMonth = document.getElementById("salaryForMonth").value;
						data.userIDForOvertime = userIDForOvertime;
						data.attendanceMonth = attendanceMonth;
						data.overtimeCheckUserId = overtimeCheckUserId;
						data.checkStatus = checkStatus;				
					}
				},
				"drawCallback": function (aData) { 
					var response = aData.json;
					if(response.recordsTotal == response.totalCheckedAttendanceRecords){
						$("#ckbCheckAll").prop("checked", true);
					}else{
						$("#ckbCheckAll").prop("checked", false);
					}
				},
				"columns": [
				{
					data: "date",
					"defaultContent": "-"
				}
				,
		 		{
					data: "startTime",
					"className": "startTimeClass",
					"defaultContent": "-",
					"render":function(data, type, row){											
										let inTime =	convertIntime(row.startTime);
										return `<span>  ${inTime} </span>`;
					}	
				}
				,{
					data: "endTime",
					"className": "endTimeClass",
					"defaultContent": "-",
					"render":function(data, type, row){											
										let outTime =	convertOuttime(row.endTime);
										return `<span>  ${outTime} </span>`;
					}	
				},{
					data: "overTime",
					"defaultContent": "-"
				},{
					data: "totalTime",
					"className": "totalTimeClass",
					"defaultContent": "-",	
				},
