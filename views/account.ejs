							columnData = `
							<div class="form-check overTimeCheckBox">
								<input class="form-check-input checkAllOTCheckBox salaryInfoToolTip" type="checkbox" id="${row._id}" value="${row._id}" checked  onclick="$.fn.overTimeCheckFunction('${row._id}','unChecked');">
								<label class="form-check-label salaryInfoToolTip" for="${row._id}">
									Overtime
								</label>
							</div>
						`				
						}else{
							columnData = `
							<div class="form-check overTimeCheckBox">
								<input class="form-check-input checkAllOTCheckBox salaryInfoToolTip" type="checkbox" id="${row._id}" value="${row._id}" onclick="$.fn.overTimeCheckFunction('${row._id}','checked');" >
								<label class="form-check-label salaryInfoToolTip" for="${row._id}">
									Overtime
								</label>
							</div>
						`				
						}
						return columnData;
					},            
				},{
					data: "",
					"defaultContent": "-",
					"render" : function(data, type, row){
						let status;
						
						var holidayOfMonth = $('#holidayOfMonth').val();
						const dayOfWeek = moment(row.startTime).day();
						const holidayResult = holidayOfMonth.includes(moment(row.startTime).format("YYYY-MM-DD").toString());
						
						if(dayOfWeek == 0){
							status = 'Sunday';
						}else if(holidayResult){
							status = 'Holiday';
						}else{
							status = '-';
						}
						return `<strong class="modeFontColor">  ${status} </strong>`;
					},
				}
				],
	
			});
	
			})

		});
	function convertIntime(intime){
		let result ;
		if(intime){	
			var s = intime.trim();		
			if(s !== "-"){
				result= (interviewTimeToHours(getLocalTime(s)));
			}else{
				result = "-";
			}
		}else{
			result = "-";
		}
		return result;
		
	}
	function convertOuttime(outtime){
		let result ;
		if(outtime){
			var e = outtime.trim();	
			if(e !== "-"){
				result= (interviewTimeToHours(getLocalTime(e)));
			}else{
				result = "-";
			}
		}else{
			result = "-";
		}
		
		return result;
	}
	function convertTotaltime(totaltime, endTime, inTime){	
		let result;
		let startLocalTime;
		//for inTime
		if(inTime){
			var s = inTime.trim();			
			if(s !== "-"){
				startLocalTime = getLocalTime(s);		
			}
		}
		
		//for outTime	
		let e ;
		if(endTime){
			e = endTime.trim();	
			if(e !== "-"){
				e = (interviewTimeToHours(getLocalTime(e)));
			}else{
				e = "-";
			}
		}else{
			e = "-";
		}
		
		//for totalTime
		let t = totaltime.trim();
		var hours,minutes;
				if(t !== "-"){
					if(e !== "-"){
					t=t.split(":");
	
					if(t[0].length==1){	
						hours = format_two_digits(parseInt(t[0]));
					}else{
						hours = t[0];
					}
	
					if(t[1].length==1){
						minutes = format_two_digits(parseInt(t[1]));
					}else{
						minutes = t[1];
					}
					result = (hours+":"+minutes)
					}else{
						let currentTime = moment().format("HH:mm");
						let workingHourss = getTimeDiffTotalMinutes(startLocalTime,currentTime);
						result = workingHourss;
					}
				}else{
					result = '-';
				}
				return result;
	}
	</script>
