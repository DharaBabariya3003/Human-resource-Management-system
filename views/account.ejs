<html lang="en">
<head>
	<!-- Import Head -->
	<style>
		.hideTd {
			display: none;
		}
		</style>
	
	<%- include('layout/head') -%>
<script src="/assets/jQuery/timepickerjs.min.js"></script>
<script src="/assets/jQuery/timepicker.min.js"></script>
</head>

<body>
	<%- include('layout/header') -%>
	<div class="app">
		<div class="app-wrapper">
			<div class="app-content pt-3 p-md-3 p-lg-4">
				<div class="container-xl">
					<div class="row g-3 mb-4 align-items-center justify-content-between">
						<div class="col-auto">								
							<h1 class="app-page-title mb-0">Employee Details : <span class="empDetails"><%= oldValues.userUpdateRecords.firstName+" "+oldValues.userUpdateRecords.middleName+" "+oldValues.userUpdateRecords.lastName %></span></h1>
							<span id="overtimeCheckUserId" class="hideOverTimeMinutes"></span>
							<span id="checkStatus" class="hideOverTimeMinutes"></span>
						</div>
					</div><!--//row-->
					<% if(oldValues.userUpdateRecords.isError) {%>
						<script>
							window.onload = function() {
								$('#popUpEditProfileWindow').modal('show')
							};
						</script>
					<%}%>									
					<nav id="orders-table-tab" class="orders-table-tab app-nav-tabs nav shadow-sm flex-column flex-sm-row mb-4">
						<a class="flex-sm-fill text-sm-center nav-link <%if(oldValues.selectedTab){if(oldValues.selectedTab.status==='profile'){%><%= 'active' %><%}}%>" id="orders-all-tab" data-toggle="tab" href="#orders-all" role="tab" aria-controls="orders-all" aria-selected="true">Profile</a>
						<a class="flex-sm-fill text-sm-center nav-link <%if(oldValues.selectedTab){if(oldValues.selectedTab.status==='payroll'){%><%= 'active' %><%}}%>" id="orders-paid-tab" data-toggle="tab" href="#orders-paid" role="tab" aria-controls="orders-paid" aria-selected="false">Payroll</a>
						<a class="flex-sm-fill text-sm-center nav-link <%if(oldValues.selectedTab){if(oldValues.selectedTab.status==='document'){%><%= 'active' %><%}}%>" id="orders-pending-tab" data-toggle="tab" href="#orders-pending" role="tab" aria-controls="orders-pending" aria-selected="false">Document</a>
						<a class="flex-sm-fill text-sm-center nav-link <%if(oldValues.selectedTab){if(oldValues.selectedTab.status==='increment'){%><%= 'active' %><%}}%>" id="orders-cancelled-tab" data-toggle="tab" href="#orders-cancelled" role="tab" aria-controls="orders-cancelled" aria-selected="false">Increment</a>
						<a class="flex-sm-fill text-sm-center nav-link <%if(oldValues.selectedTab){if(oldValues.selectedTab.status==='salarySlip'){%><%= 'active' %><%}}%>" id="salary-slip-tab" data-toggle="tab" href="#salary-slip" role="tab" aria-controls="salary-slip">Salary Slip</a>
					</nav><!--//nav-->						
					<div class="tab-content" id="orders-table-tab-content">
						<div class="tab-pane <%if(oldValues.selectedTab){
              if(oldValues.selectedTab.status==='profile'){%>
              <%= 'show active' %>
              <%}}%> " id="orders-all" role="tabpanel" aria-labelledby="orders-all-tab">
								<div class="app-card app-card-orders-table shadow-sm mb-5 card-neumorphic">
									<div class="app-card-body">
										<div class="table-responsive">
											<div class="col-12 col-lg-12">                                                
												<% if(oldValues.userUpdateRecords) {%>
													<div class="app-card-header p-3 border-bottom-0">
														<div class="row align-items-center gx-3">
															<div class="col-auto">
																<div class="app-icon-holder">
																	<svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-person" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
																		<path fill-rule="evenodd" d="M10 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm6 5c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z" />
																	</svg>
																</div>																
															</div>																
															<div class="col-auto">	
																<h4 class="app-card-title">Profile</h4>
															</div>
															<div class="col text-right" style="position:absolute; right:0;">
																<a class="btn btn-success btn-green-neumorpic" href="/admin/<%= oldValues.userUpdateRecords._id %>/employee">
																	Edit Profile
																</a>
																<a class="btn btn-primary btn-blue-neumorpic" href="/public/uploadqrCode/qrCode.pdf" data-fancybox="gallery">
																	Generate QR Code
															 </a>
															</div>																	
															<div class="modal fade" id="popUpEditProfileWindow" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
																<div class="modal-dialog">
																	<div class="modal-content">
																		<div class="modal-header">																			
																			<h4 class="modal-title w-100 text-left" id="myModalLabel"><b>Edit Employee Details</b></h4>
																			<button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
																		</div>
																		<div class="modal-body">
																			<div class="row g-4 settings-section">
																				<div class="col-12 col-md-12">
																					<div class="app-card app-card-settings p-4 card-neumorphic">
																						<div class="app-card-body">
																							<% let date=new Date(oldValues.userUpdateRecords.birthDate); date=date.toISOString().slice(0,10); %>
																							<form method="POST" action="/admin/<%= oldValues.userUpdateRecords._id %>/employee?isfromView=true" enctype="multipart/form-data">
																								<div class="app-card app-card-accordion shadow-sm mb-4 ">
																									<div class="app-card-header p-3 bg-success cardHeader">
																										<h4 class="app-card-title"><strong>Basic Details :</strong></h4>
																									</div>																									
																									<!--//app-card-header-->
																									<div class="app-card-body p-2 pt-0">
																										<div id="faq2-accordion" class="faq2-accordion faq-accordion accordion">
																											<div class="item border-bottom py-3">
																												<div class="row justify-content-between align-items-center row-6">
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>First Name:<span class="requiredField">*</span></strong>
																																</div>
																																<div class="item-data">
																																	<input name="firstName" class="form-control"
																																		placeholder="First Name" type="text" required
																																		value=<%- JSON.stringify(oldValues.userUpdateRecords.firstName)%>>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Middle Name:</strong></div>
																																<div class="item-data">
																																	<input name="middleName" class="form-control"
																																		placeholder="Middle Name"  type="text"
																																		value=<%- JSON.stringify(oldValues.userUpdateRecords.middleName)
																																		%>>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Last Name:<span class="requiredField">*</span></strong>
																																</div>
																																<div class="item-data">
																																	<input name="lastName" class="form-control"
																																		placeholder="Last Name" required type="text"
																																		value=<%- JSON.stringify(oldValues.userUpdateRecords.lastName) %>>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																												</div>
																												<!--//row-->
																											</div>
																											<!--//item-->
																											<div class="item border-bottom py-3">
																												<div class="row justify-content-between align-items-center row-6">
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Email Address:<span class="requiredField">*</span></strong>
																																</div>
																																<div class="item-data">
																																	<input name="email" class="form-control restrictSpace"
																																		placeholder="Email Address" required
																																		type="email" value=<%=oldValues.userUpdateRecords.email %>>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Birth Date:</strong>
																																</div>
																																<div class="item-data">
																																	<input name="birthDate" class="form-control"
																																		placeholder="Birth" type="date" min="1900-01-01"
																																		max="9999-12-31" style="margin-right: 10px;"
																																		value=<%=date %>>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Gender:</strong></div>
																																<div class="item-data">
																																	<select name="gender" class="form-control form-select">
																																		<option value="Male" <%
																																			if(oldValues.userUpdateRecords.gender=='Male' ) {%>
																																			<%= 'selected' %>
																																				<%} %>
																																					>Male
																																		</option>
																																		<option value="Female" <%
																																			if(oldValues.userUpdateRecords.gender=='Female' ) {%>
																																			<%= 'selected' %>
																																				<%} %>>Female
																																		</option>
																																		<option value="Others" <%
																																			if(oldValues.userUpdateRecords.gender=='Others' ) {%>
																																			<%= 'selected' %>
																																				<%} %>>Others
																																		</option>
																																	</select>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																												</div>
																											</div>
																											<!--//item-->
																											<div class="item border-bottom py-3">
																												<div class="row justify-content-between align-items-center row-6">
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Your Contact Info:<span class="requiredField">*</span></strong></div>
																																<div class="item-data">
																																	<input name="contactNumber" class="form-control"
																																		required
																																		placeholder="Contact Info."
																																		type="number"
																																		onKeyPress="if(this.value.length==10) return false;"
																																		value=<%=oldValues.userUpdateRecords.contactNumber %>>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Emergency Contact Info:</strong></div>
																																<div class="item-data">
																																	<input name="emergencyContactNumber"
																																		class="form-control"
																																		placeholder="Emrgency Contact Info."
																																		type="number"
																																		onKeyPress="if(this.value.length==10) return false;"
																																		value=<%if(oldValues.userUpdateRecords) {
																																		if(!oldValues.userUpdateRecords.emergencyContactNumber=='0000000000'
																																		) {%>
																																	<%= oldValues.userUpdateRecords.emergencyContactNumber %>
																																		<%} }%>>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Position:</strong></div>
																																<div class="item-data">
																																	<select name="position" class="form-control form-select">
																																		<option value="Trainee" <%
																																			if(oldValues.userUpdateRecords.position=='Trainee' ) {%>
																																			<%= 'selected' %>
																																				<%} %>>Trainee
																																		</option>
																																		<option value="Employee" <%
																																			if(oldValues.userUpdateRecords.position=='Employee' ) {%>
																																			<%= 'selected' %>
																																				<%} %>>Employee
																																		</option>
																																	</select>
																																</div> <!-- form-group end.// -->
																															</div>
																														</div>
																													</div>
																												</div>
																											</div>
																											<!--//item-->
																											<div class="item border-bottom py-3">
																												<div class="row justify-content-between align-items-center row-6">
																													<div class="col-sm-6">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Correspondence Address:<span class="requiredField">*</span></strong></div>
																																<div class="item-data">
																																	<textarea name="correspondenceAddress" required
																																		 placeholder="Correspondence Address" style="height: 87px !important;"
																																		class="form-control"><%if(oldValues.userUpdateRecords){
																																			if(oldValues.userUpdateRecords.correspondenceAddress!='-'){%>
																																				<%= oldValues.userUpdateRecords.correspondenceAddress %>
																																			<%}
																																		}%></textarea>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-6">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Permanent Address:</strong></div>
																																<div class="item-data">
																																	<textarea name="permanentAddress"
																																		 placeholder="Permanent Address" style="height: 87px !important;"
																																		class="form-control"><%if(oldValues.userUpdateRecords){
																																			if(oldValues.userUpdateRecords.permanentAddress!='-'){%>
																																				<%= oldValues.userUpdateRecords.permanentAddress %>
																																			<%}
																																		}%></textarea>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																												</div>
																											</div>
																											<!--//item-->
																											<div class="item border-bottom py-3">
																												<div class="row justify-content-between align-items-center row-6">
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Department:</strong></div>
																																<div class="item-data">
																																	<select id="combo"  onchange="getDepartment();"  name="department" class="form-control form-select">
																																		<%if(oldValues.userUpdateRecords.allDept){
																																			if(oldValues.userUpdateRecords.allDept.length>0){
																																				oldValues.userUpdateRecords.allDept.forEach(element=>{%>
																																					<option value=<%= element._id %> <%if(''+oldValues.userUpdateRecords.department==''+element._id){%>
																																						selected
																																					<%}%>> <%= element.departmentName %></option>
																																				<%})
																																		}}%>
																																	</select>																																	
																																</div> <!-- form-group end.// -->
																																<div class="item-data refreshFormat">
																																	<i class="fas fa-redo-alt" onclick="getDepartmentRefresh()" style="cursor: pointer;"></i>
																																</div>
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Designation:</strong></div>
																																<div class="item-data">																																
																																	<select id="selectDeg" name="designation" class="form-control form-select">
																																		<%if(oldValues.userUpdateRecords.allDesg){
																																			if(oldValues.userUpdateRecords.allDesg.length>0){
																																				oldValues.userUpdateRecords.allDesg.forEach(element=>{%>
																																			<option value=<%= element._id %> <%if(''+oldValues.userUpdateRecords.designation==''+element._id){%>
																																				selected
																																			<%}%>> <%= element.designationName %></option>
																																			<%})
																																		}}%>																															
																																	</select>
																																</div> <!-- form-group end.// -->
																																<div class="item-data refreshFormat">
																																	<i class="fas fa-redo-alt" onclick="getDepartment()" style="cursor: pointer;"></i>
																																</div>
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Vehicle Number:</strong></div>
																																<div class="item-data">
																																	<input name="vehicalNumber" class="form-control"
																																		placeholder="Vehicle Number" type="text"
																																		value=<%if(oldValues.userUpdateRecords){
																																			if(oldValues.userUpdateRecords.vehicalNumber!='-'){%>
																																				<%- JSON.stringify( oldValues.userUpdateRecords.vehicalNumber) %>
																																			<%}
																																		}%>>
																																</div>
																															</div>
																														</div>
																													</div>																												
																												</div>
																											</div>
																											<!--//item-->																										
																											<div class="item border-bottom py-3" style="border-bottom: none !important;">
																												<div class="row justify-content-between align-items-center row-6">
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Marital Status:</strong></div>
																																<div class="item-data">
																																	<select id="statusSelector" name="status"
																																		class="form-control form-select">
																																		<option value="Single" <%
																																			if(oldValues.userUpdateRecords.status=='Single' ) {%>
																																			<%= 'selected' %>
																																				<%} %>>Single
																																		</option>
																																		<option value="Married" <%
																																			if(oldValues.userUpdateRecords.status=='Married' ) {%>
																																			<%= 'selected' %>
																																				<%} %>
																																					>Married
																																		</option>
																																	</select>
																																</div> <!-- form-group end.// -->
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3" id="MarriageDateSelection">
																																<div class="item-label"><strong>Marriage Date:</strong><span class="requiredField">*</span></div>
																																<div class="item-data">
																																	<input name="marriageDate" class="form-control"
																																		type="date" style="margin-right: 10px;"
																																		min="1900-01-01" max="9999-12-31"
																																		value=<%if(oldValues.userUpdateRecords.marriageDate) { %>
																																			<%= oldValues.userUpdateRecords.marriageDate%>
																																		<%}else{%>
																																			<%= oldValues.moment(new Date()).format("YYYY-MM-DD"); %>
																																		<%}%>>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>&nbsp;</strong></div>
																																<div class="item-data"></div>
																															</div>
																														</div>
																													</div>
																												</div>
																											</div>
																											<!--//item-->
																										</div>
																										<!--//faq2-accordion-->
																									</div>
																									<!--//app-card-body-->
																								</div>
																								<!--//app-card-->
																								<div class="app-card app-card-accordion shadow-sm mb-4">
																									<div class="app-card-header p-3 bg-success cardHeader">
																										<h4 class="app-card-title"><strong>Education Details :</strong></h4>
																									</div>
																									<!--//app-card-header-->
																									<div class="app-card-body p-2 pt-0">
																										<div id="faq2-accordion" class="faq2-accordion faq-accordion accordion">
																											<div class="item border-bottom py-3" style="border-bottom: none !important;">
																												<div class="row justify-content-between align-items-center row-6">
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>Degree:</strong></div>
																																<div class="item-data">
																																	<input name="degree"  class="form-control"
																																		placeholder="Degree" type="text" value=<%if(oldValues.userUpdateRecords){
																																			if(oldValues.userUpdateRecords.degree!='-'){%>
																																				<%- JSON.stringify( oldValues.userUpdateRecords.degree) %>
																																			<%}
																																		}%>>
																																</div> <!-- form-group// -->
																															</div>
																														</div>
																													</div>
																													<div class="col-sm-4">
																														<div class="col-auto">
																															<div class="mb-3">
																																<div class="item-label"><strong>College Name:</strong></div>
																																<div class="item-data">
