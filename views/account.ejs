						$('#trackerOT').text(data.salaryInformation.trackerOT);
						$('#clientTrackerOT').text(data.salaryInformation.clientTrackerOT);

						
						$('#totalOvertimeRupees').text(data.salaryInformation.overtime_rupees.toFixed(2));
						$('#cardOTRupees').text(data.salaryInformation.cardOTRupees.toFixed(2));
						$('#trackerOTRupees').text(data.salaryInformation.trackerOTRupees.toFixed(2));
						$('#clientTrackerOTRupees').text(data.salaryInformation.clientTrackerOTRupees.toFixed(2));


